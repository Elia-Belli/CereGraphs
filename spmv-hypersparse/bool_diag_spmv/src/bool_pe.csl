// Boolean-semiring SpMV, one iteration, using collectives_2d (a local, in-tree
// copy -- see src/collectives_2d/, vendored from the container's <collectives_2d>
// stdlib so stage 2 of the bitmap work can add an OR-reduce without touching
// the system-wide module other kernels/examples import) instead of
// hand-rolled fabric routing (see gemv-collectives_2d/pe.csl for the
// reference pattern this follows).
//
// The matrix A (n-by-n, boolean) is partitioned into a P-by-P grid of PEs
// using the SAME hypersparse compressed-column format as hypersparse_spmv
// (mat_col_idx/loc/len_buf, mat_rows_buf) -- just without mat_vals_buf,
// since boolean semiring never uses edge weights. Unlike hypersparse_spmv,
// mat_rows_buf holds a direct dense row-block index (not a compact index
// into a separate distinct-row list) -- see y_bitmap's own comment below.
//
// Communication is targeted at the grid diagonal (pcol_id == prow_id) rather
// than a fixed corner:
//   - phase 1: mpi_y.broadcast(root=pcol_id, x_bitmap, ...) -- every PE in a
//     column receives the SAME x-block (packed as a bitmap), sourced from
//     that column's diagonal PE (row == pcol_id). Only the diagonal PE's
//     x_bitmap is seeded with real data (host memcpy); everyone else's is
//     overwritten by the broadcast.
//   - phase 2: mpi_x.reduce_or(root=prow_id, y_bitmap, y_bitmap_reduced, ...)
//     -- every PE in a row sends its local boolean contribution (packed as
//     a bitmap) toward that row's diagonal column (== prow_id), which ends
//     up holding the final, genuinely bitwise-OR'd result.
//
// This choice of diagonal target (instead of a scattered or corner-gathered
// result) is what lets a later BFS loop reuse phase 1 unmodified: the PE
// that produces row py's final result (the diagonal PE of that row) is
// exactly the PE that needs to source the next iteration's broadcast down
// its own column.
//
// f_spmv_iter runs this without a host round trip, masking each round's raw
// result against a cumulative visited_bitmap (see reduce_done()) before
// feeding it back as the next round's x -- i.e. only genuinely new
// discoveries propagate, same as bfs_spmv/run_bfs.py's host-side
// `new_mask = candidate & ~visited`. It stops once a 4-phase relay (see
// reduce_done()/term_col_done()/term_row_done()/term_row_bcast_done()/
// term_col_bcast_done()) agrees no row found anything new this round --
// no fixed round count, no host round trip anywhere in the loop.
// Convergence under visited-masking is monotonic (every round either finds
// >=1 new node or stops) and bounded by the node count, so this is
// guaranteed to terminate.
//
// Parent tracking (which vertex discovered a given node) can't use the
// row-reduce at all -- it's a combine (OR), not a selection, so it can't
// answer "which PE contributed" once more than one predecessor fires in the
// same round (see bfs_spmv/run_bfs.py's own docstring point 3 for the same
// limitation on the host-orchestrated version). Instead, parent is tracked
// per-PE, BEFORE the reduce (see compute()): every PE (i,j) in row i knows
// exactly which of its own local columns touched which local row this
// round, which the row-reduce's aggregation would otherwise throw away.
//
// A candidate is only ever recorded for a row that ISN'T YET VISITED (see
// the visited_bitmap bit-test in compute()) -- without that
// gate, a row that was already visited several rounds ago could still get
// touched by a later round's frontier (any node with a real structural
// edge into it, however many hops away that node actually is), silently
// overwriting a true one-hop-closer parent with an unrelated, invalid one
// whenever the later node's global index happened to be lower. Since no PE
// can ever see a hit on a row before that row's actual global discovery
// round (a hit at any PE immediately makes the row visited by the end of
// that same round, via the row-reduce all PEs share), gating on
// visited_bitmap restricts candidate recording to exactly a row's true
// discovery round -- gives a genuine, textbook one-hop-closer BFS parent,
// not merely a valid-but-arbitrary predecessor. This requires visited_bitmap
// (otherwise meaningful only at the diagonal PE, see its own comment
// below) to be distributed to every PE in the row before compute() runs
// each round -- see visited_bcast_done()/term_col_bcast_done() below.
//
// Each PE keeps parent_local_buf, indexed identically to x_bitmap/y_bitmap
// (dense over its row-block), holding a column it has recorded for each
// local row -- stored as a LOCAL column index (0..blk-1), not the global
// vertex id, which keeps this buffer u16-safe at any n (see PARENT_NONE's
// own comment). The tie-break for multiple local columns hitting the same
// row in the same discovery round is intentionally NOT the lowest global
// index -- any candidate gated by visited_bitmap above is already a legal
// one-hop-closer parent, so there's no correctness reason to prefer the
// minimum one, and dropping that comparison saves a compare per row-hit
// (see the parent-tracking pass in compute() below: whichever local column
// is walked last for a given row wins). Because different PEs in the SAME
// row cover different column ranges, extract_parent_result() in
// ../device_io.py reconstructs each candidate's global vertex id
// (pcol_id*blk + local column, using the pcol_id it already knows from the
// readback layout) and then still combines each row's P per-PE candidates
// host-side after memcpy_d2h (via min(), for lack of any on-device
// min/select primitive -- <collectives_2d> has no min-reduce) -- this
// remains correct since the min of several legal predecessors is itself a
// legal predecessor, even though it's no longer "the true global lowest
// index" in the old sense.

param memcpy_params;
param c2d_params;

param blk: u16;                 // per-PE dense vector chunk size = ceil(n/P)
param max_local_nnz: u16;       // max local number of nonzeros (matrix structure only, no vals)
param max_local_nnz_cols: u16;  // max local number of nonzero columns
param max_local_nnz_rows: u16;  // max local number of nonzero rows
param max_rounds: u16;          // upper bound on f_spmv_iter rounds profiled by ts_buf below

const compute_task_id: local_task_id = @get_local_task_id(10);
const reduce_done_task_id: local_task_id = @get_local_task_id(11);
// termination-check relay (see reduce_done()/MID below) -- 14-17 are taken
// by <collectives_2d>'s own x/y entrypoints (see the map in layout_bool.csl).
const term_col_done_task_id: local_task_id = @get_local_task_id(12);
const term_row_done_task_id: local_task_id = @get_local_task_id(13);
const term_row_bcast_done_task_id: local_task_id = @get_local_task_id(18);
const term_col_bcast_done_task_id: local_task_id = @get_local_task_id(19);
// distributes visited_bitmap across each row before compute() runs -- see the
// module docstring above and visited_bcast_done() below.
const visited_bcast_done_task_id: local_task_id = @get_local_task_id(20);

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// tsc timing, bracketing just broadcast+compute+reduce (memcpy happens
// before f_tic is launched). No cross-PE clock-skew correction (unlike
// hypersparse_spmv's allreduce2R1E-based f_sync) -- for a quick relative
// comparison this is run with the same simplified methodology on both
// kernels, so the raw min/max is treated as directly comparable rather than
// as an absolute hardware-calibrated figure.
const timestamp = @import_module("<time>");
var tsc_start_buffer = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buffer = @zeros([timestamp.tsc_size_words]u16);

// Per-round, per-phase timing (f_spmv_iter only -- see record_ts() below).
// One raw hardware timestamp is captured at each of these round-boundary
// points; host-side (bfs_timing.py, used by run_bfs.py) subtracts
// consecutive pairs (as 48-bit values, cerebras.sdk.sdk_utils.make_u48) to
// get each phase's elapsed cycles, and MID-1/MID-2 vs. the rest gives
// min/max/avg across
// PEs once every PE's copy is read back. Two consecutive slots delimit one
// phase; where a task immediately re-issues the next collective with no
// other work in between, its entry timestamp doubles as both the previous
// phase's end and the next phase's start (see the call sites below):
//   0 TS_VBCAST_ISSUE        -- before mpi_x.broadcast(visited_bitmap)
//   1 TS_VBCAST_DONE         -- entry of visited_bcast_done() (visited
//                                bcast end / vertical x_bitmap bcast start)
//   2 TS_COMPUTE_ENTRY       -- entry of compute() (vertical bcast end /
//                                local compute start)
//   3 TS_COMPUTE_RESET_DONE  -- between compute()'s buffer resets (y_bitmap
//                                and y_bitmap_reduced, both BITMAP_WORDS =
//                                ceil(blk/32) words) and the actual compact
//                                boolean multiply -- isolates the resets
//                                from the sparse work itself (see
//                                bfs_timing.py's local_compute_reset)
//   4 TS_COMPUTE_EXPAND_ENTRY -- immediately after the compact boolean
//                                multiply (sets bits in y_bitmap, one per
//                                real local row hit; also inline-merges
//                                parent_local_buf, see its own comment), at
//                                the exact same point as TS_REDUCE_ISSUE
//                                below -- reduce_or consumes y_bitmap
//                                directly, so there's no expand step left
//                                between them any more (there was, before
//                                <collectives_2d> grew an OR-reduce);
//                                local_compute_expand reads ~0 cycles from
//                                here on, by design, not a bug. Kept (not
//                                deleted) for CSV/schema continuity -- see
//                                bfs_timing.py's local_compute_reset/
//                                local_compute_compact/local_compute_expand
//                                (a prior two-pass split experiment did use
//                                this slot as a real Phase A/B boundary --
//                                see compute()'s own comment for why it was
//                                reverted)
//   5 TS_REDUCE_ISSUE        -- before mpi_x.reduce_or in compute() (see
//                                TS_COMPUTE_EXPAND_ENTRY just above)
//   6 TS_REDUCE_DONE         -- entry of reduce_done() (reduce end / local
//                                term-condition start)
//   7 TS_RELAY_ISSUE         -- before mpi_y.broadcast(nz_local) in
//                                reduce_done() (local term-cond end /
//                                relay phase A start)
//   8 TS_TERM_COL_DONE       -- entry of term_col_done() (relay phase A
//                                [col-bcast, rooted at each column's own
//                                diagonal -- was a col-reduce] end / phase
//                                B start)
//   9 TS_TERM_ROW_DONE       -- entry of term_row_done() (relay phase B
//                                [row-reduce] end / phase C start)
//   10 TS_TERM_ROW_BCAST_DONE -- entry of term_row_bcast_done() (relay
//                                phase C [row-bcast] end / phase D start)
//   11 TS_TERM_COL_BCAST_DONE -- entry of term_col_bcast_done() (relay
//                                phase D [col-bcast] end / relay total end)
const TS_VBCAST_ISSUE: u16 = 0;
const TS_VBCAST_DONE: u16 = 1;
const TS_COMPUTE_ENTRY: u16 = 2;
const TS_COMPUTE_RESET_DONE: u16 = 3;
const TS_COMPUTE_EXPAND_ENTRY: u16 = 4;
const TS_REDUCE_ISSUE: u16 = 5;
const TS_REDUCE_DONE: u16 = 6;
const TS_RELAY_ISSUE: u16 = 7;
const TS_TERM_COL_DONE: u16 = 8;
const TS_TERM_ROW_DONE: u16 = 9;
const TS_TERM_ROW_BCAST_DONE: u16 = 10;
const TS_TERM_COL_BCAST_DONE: u16 = 11;
const NUM_TS_SLOTS: u16 = 12;

// flat [max_rounds][NUM_TS_SLOTS][3]u16, row-major (round slowest, then
// slot, then the 3 raw timestamp words) -- see record_ts() for the index
// arithmetic. No per-call reset needed: the host only ever reads the
// [0, rounds_completed) prefix (see ../run_bfs.py), so stale entries
// from a longer PRIOR run past the current run's rounds_completed are
// simply never looked at.
var ts_buf = @zeros([max_rounds * NUM_TS_SLOTS * 3]u16);
var ts_scratch = @zeros([timestamp.tsc_size_words]u16);
// which round record_ts() below should file its captures under -- see the
// two assignment sites (start_spmv(), term_col_bcast_done()) for why this
// can't just be rounds_completed[0] directly (that counter increments
// mid-round, in reduce_done(), before the relay phases' own captures).
var ts_round: u16 = 0;

fn record_ts(round: u16, slot: u16) void {
    if (round < max_rounds) {
        timestamp.get_timestamp(&ts_scratch);
        const base: u16 = (round * NUM_TS_SLOTS + slot) * 3;
        ts_buf[base] = ts_scratch[0];
        ts_buf[base + 1] = ts_scratch[1];
        ts_buf[base + 2] = ts_scratch[2];
    }
}

// queues/dsr_ids mirror gemm-collectives_2d/pe.csl -- they don't conflict
// with memcpy's queue 0.
//
// Local repo copy (bool_diag_spmv/src/collectives_2d/), not the container's
// <collectives_2d> -- vendored in-tree so stage 2 of the bitmap work (an
// OR-reduce, and whatever broadcast adjustments it needs) can be
// experimented on freely without touching the system-wide stdlib module
// that other kernels/examples also import.
const mpi_x = @import_module("./collectives_2d/pe.csl", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2, 4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1},
    });
const mpi_y = @import_module("./collectives_2d/pe.csl", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3, 5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2},
    });

// matrix structure, populated per-PE by run_single_spmv.py/run_bfs.py via
// memcpy (hypersparse compressed-column format, identical to
// hypersparse_spmv minus mat_vals_buf)
var mat_rows_buf = @zeros([max_local_nnz]u16);
var mat_col_idx_buf = @zeros([max_local_nnz_cols]u16);
var mat_col_loc_buf = @zeros([max_local_nnz_cols]u16);
var mat_col_len_buf = @zeros([max_local_nnz_cols]u16);

var local_nnz = @zeros([1]u16);
var local_nnz_cols = @zeros([1]u16);
var local_nnz_rows = @zeros([1]u16);

// Real termination check (see reduce_done()): <collectives_2d> only gives
// us per-row (mpi_x) or per-column (mpi_y) primitives, never "the
// diagonal" directly, so reaching from one diagonal PE to another always
// means relaying through a full row AND a full column. That forces a
// 4-phase relay -- column-broadcast (rooted at each column's own diagonal,
// not MID -- only the diagonal ever has real data, so this moves it rather
// than reducing it), row-reduce, row-broadcast, column-broadcast (these
// last three still rooted at MID on both axes) -- which lands the
// aggregation point at (MID, MID): itself a diagonal PE, and (for the
// three MID-rooted phases) the position that minimizes each phase's
// worst-case chain latency (max(root, P-1-root) hops, per <collectives_2d>'s
// own linear-chain implementation).
// The middle two phases (row-reduce, row-broadcast) are only ever real
// work for row MID -- every other row's own copy would combine/broadcast
// data nobody reads, so term_col_done() has them skip straight to the
// last phase instead (see its own comment).
const P: u16 = @get_rectangle().width;
const MID: u16 = P / 2;

// nz_local: this round's local "did I find anything new" flag, real only
// at the diagonal PE (pcol_id == prow_id) -- every other row's own value
// is always 0, so phase 6 (below) is a broadcast, not a reduce: nothing
// to sum, just move the diagonal's one real value to the rest of the
// column. After that broadcast, every row's own nz_local holds the same
// (that column's) shared value -- no separate nz_col buffer needed.
// nz_total: after the row-reduce, meaningful only at (MID, MID)
var nz_local = @zeros([1]f32);
var nz_total = @zeros([1]f32); // termination condition

// rounds_completed: host-visible counter of how many rounds f_spmv_iter
// actually ran this call, purely for verifying early termination actually
// happens (see ../run_host_driven_bfs.py) -- not read by the kernel itself.
var rounds_completed = @zeros([1]u16);

// y_bitmap: dense per-PE bitmap over this PE's row-block (bit k == row k of
// blk, matching x_bitmap's own indexing), set by the local multiply below and
// fed directly into reduce_or as its send buffer -- see compute(). Replaces
// the old compact-index y_flags/y_rows_init_buf scheme -- mat_rows_buf now
// gives a dense row index directly (see preprocess_bool.py), so there is
// no compact index space to maintain.
//
// Layout: word_idx = k >> 5, bit_idx = k & 31 -- every word covers 32 rows
// except possibly the last, which is partial whenever blk % 32 != 0.
// Invariant (relied on by reduce_or's own OR-reduce over these words):
// any bit at position >= blk (i.e. past the last real row, within the last
// word) is ALWAYS 0 -- the reset below zeroes it, and the only bit-set site
// uses `k` values that always come from mat_rows_buf, which is
// host-populated from real structural rows and therefore always < blk.
// Never explicitly masked; true by construction.
const BITMAP_WORDS: u16 = (blk + 31) / 32;

// x_bitmap: this PE's dense column-block of x, packed the same way
// y_bitmap is (bit k == column k of blk). Broadcast() is dtype-agnostic
// (confirmed stage 2a), so this needs no @ptrcast at its broadcast call
// sites -- just BITMAP_WORDS instead of blk as the element count.
var x_bitmap = @zeros([BITMAP_WORDS]u32);

// visited_bitmap: cumulative "ever discovered" set for f_spmv_iter, packed
// the same way, indexed identically to x_bitmap (same row/column block).
// Real writes only ever happen at the diagonal PE: seeded from the initial
// x_bitmap in start_spmv(), OR'd with every round's genuinely-new
// discoveries in reduce_done(). Every other PE in the row gets a fresh copy
// each round via visited_bcast_done() (same "only the diagonal's copy is
// real, broadcast overwrites everyone else's" convention x_bitmap already
// uses) -- compute() needs this at every PE to gate parent tracking (see
// the module docstring above). Never used or touched by plain f_spmv (see
// the is_iterative guards below).
var visited_bitmap = @zeros([BITMAP_WORDS]u32);

var y_bitmap = @zeros([BITMAP_WORDS]u32);

// y_bitmap_reduced: final row-block result after reduce_or, packed the same
// way y_bitmap is. Separate memory from y_bitmap -- reduce_or's own
// internal FSM assumes send/recv buffers are independent (e.g. the root
// PE's own-copy merge step reads both), so they must not alias. Replaces
// the old dense-f32 y_buf (and the y_local_buf send-side copy it needed)
// now that the row-reduce operates directly on the bitmap. The host reads
// back the full rectangle and keeps only the diagonal entries (see
// device_io.unpack_bitmap_to_dense/extract_diag_result).
var y_bitmap_reduced = @zeros([BITMAP_WORDS]u32);

// Fast dense-buffer reset: a single DSD op per buffer instead of a
// BITMAP_WORDS-iteration scalar while loop. zero_scalar_u32 is a permanent
// one-element zero source (written once at load, never again); fill_bitmap_u32
// reads that same element `extent`-many times (stride 0, a broadcast read)
// so @mov32 can stream a whole buffer's worth of zeros in one
// hardware-driven pass, exploiting the tensor engine's SIMD streaming
// instead of per-element scalar stores. Comptime (BITMAP_WORDS is a
// compile-time param-derived constant), so built once at module scope and
// reused unchanged every round.
var zero_scalar_u32 = @zeros([1]u32);
const fill_bitmap_u32 = @get_dsd(mem1d_dsd, .{ .base_address = &zero_scalar_u32, .extent = BITMAP_WORDS, .stride = 0 });
const y_bitmap_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &y_bitmap, .extent = BITMAP_WORDS });
const y_bitmap_reduced_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &y_bitmap_reduced, .extent = BITMAP_WORDS });

// sentinel meaning "no candidate parent seen". Only needs to exceed the max
// valid LOCAL column index (blk-1), not the max global vertex index --
// parent_local_buf stores a local column index, not a global vertex id (see
// its own comment below), so this is independent of n and already safely
// satisfied by preprocess_bool.py's own blk < 65535 assertion.
const PARENT_NONE: u16 = 65535;

// parent_local_buf: this PE's own candidate parent, dense over its
// row-block like x_bitmap, PERSISTED across rounds (never reset
// except at a fresh f_spmv_iter call in start_spmv()) -- holds the LOCAL
// column index (0..blk-1, see compute()) this PE has recorded for each
// local row, across every round. Deliberately not the global vertex id:
// every candidate compared/stored for a given PE shares that PE's own
// pcol_id, so keeping just the local index is equivalent (see compute()'s
// own comment) while keeping this buffer u16-safe regardless of n. The
// global vertex id (pcol_id*blk + local column) is reconstructed host-side
// in device_io.py's extract_parent_result(), which already knows each
// slice's pcol_id from the readback layout, before combining each row's P
// per-PE candidates (see the module docstring above for why that combine
// step is needed at all, and why it's a min rather than a specific pick).
var parent_local_buf = @zeros([blk]u16);

var ptr_x_bitmap: [*]u32 = &x_bitmap;
var ptr_y_bitmap_reduced: [*]u32 = &y_bitmap_reduced;
var ptr_visited_bitmap: [*]u32 = &visited_bitmap;
var ptr_rounds_completed: [*]u16 = &rounds_completed;
var ptr_parent_local_buf: [*]u16 = &parent_local_buf;
var ptr_mat_rows_buf: [*]u16 = &mat_rows_buf;
var ptr_mat_col_idx_buf: [*]u16 = &mat_col_idx_buf;
var ptr_mat_col_loc_buf: [*]u16 = &mat_col_loc_buf;
var ptr_mat_col_len_buf: [*]u16 = &mat_col_len_buf;
var ptr_local_nnz: [*]u16 = &local_nnz;
var ptr_local_nnz_cols: [*]u16 = &local_nnz_cols;
var ptr_local_nnz_rows: [*]u16 = &local_nnz_rows;

var ptr_tsc_start_buffer: [*]u16 = &tsc_start_buffer;
var ptr_tsc_end_buffer: [*]u16 = &tsc_end_buffer;
var ptr_ts_buf: [*]u16 = &ts_buf;

var pcol_id: u16;
var prow_id: u16;

// mpi_x/mpi_y.init() only needs to run per device session, not per launch
var mpi_initialized: bool = false;

// true for f_spmv_iter calls (masking/visited/termination-relay logic
// applies), false for plain f_spmv (always exactly one round, untouched).
var is_iterative: bool = false;

fn f_enable_tsc() void {
    timestamp.enable_tsc();
    sys_mod.unblock_cmd_stream();
}

fn f_tic() void {
    timestamp.get_timestamp(&tsc_start_buffer);
    sys_mod.unblock_cmd_stream();
}

fn f_toc() void {
    timestamp.get_timestamp(&tsc_end_buffer);
    sys_mod.unblock_cmd_stream();
}

fn start_spmv() void {
    if (!mpi_initialized) {
        mpi_x.init();
        mpi_y.init();
        mpi_initialized = true;
    }
    pcol_id = mpi_x.pe_id;
    prow_id = mpi_y.pe_id;

    // At the start of new BFS: 
    // - Reset the visited as the new x
    // - Reset the parent_local_buf to PARENT_NONE
    if (is_iterative and pcol_id == prow_id) {

        var w: u16 = 0;
        while (w < BITMAP_WORDS) : (w += 1)
        {
            visited_bitmap[w] = x_bitmap[w];
        }
    }
    if (is_iterative) {

        var p: u16 = 0;
        while (p < blk) : (p += 1) 
        {
            parent_local_buf[p] = PARENT_NONE;
        }
    }


    // Start the first round of SpMV (or the next round of iterative SpMV)
    if (is_iterative) {

        rounds_completed[0] = 0;
        ts_round = rounds_completed[0];
        record_ts(ts_round, TS_VBCAST_ISSUE);

        // Phase 1: broadcast visited bitmap along each row (needed for parent tracking)
        mpi_x.broadcast(prow_id, &visited_bitmap, BITMAP_WORDS, visited_bcast_done_task_id);

    } else {
        // SpMV: just broadcast x_bitmap down the column
        mpi_y.broadcast(pcol_id, &x_bitmap, BITMAP_WORDS, compute_task_id);
    }
}

task visited_bcast_done() void {

    record_ts(ts_round, TS_VBCAST_DONE);

    // Phase 2: broadcast x_bitmap down the column
    mpi_y.broadcast(pcol_id, &x_bitmap, BITMAP_WORDS, compute_task_id);
}

// compute y = A*x, one iteration, boolean semiring, reduce to the diagonal
fn f_spmv() void {
    is_iterative = false;
    start_spmv();
}

// same as f_spmv, but after reducing to the diagonal, copies y back into x
// (broadcasting it again down the diagonal's column) and repeats until the
// termination relay (see reduce_done()) agrees no row found anything new --
// i.e. the output of each round becomes the next round's input vector, for
// as many rounds as real BFS convergence takes, before returning control to
// the host.
fn f_spmv_iter() void {
    is_iterative = true;
    start_spmv();
}

// compute() runs once per round
task compute() void {
    if (is_iterative) {
        record_ts(ts_round, TS_COMPUTE_ENTRY);
    }

    // Reset y_bitmap and y_bitmap_reduced
    @mov32(y_bitmap_dsd, fill_bitmap_u32);
    @mov32(y_bitmap_reduced_dsd, fill_bitmap_u32);

    if (is_iterative) {
        record_ts(ts_round, TS_COMPUTE_RESET_DONE);
    }

    // Phase 3 Local boolean multiply: for every locally-nonzero column c with
    // x_bitmap's bit c set, set the bit for every local (dense) row it
    // touches. Also merge a candidate parent directly into the persistent
    // parent_local_buf -- inline, no separate per-round scratch buffer --
    // BEFORE the reduce below discards column identity. This is safe
    // because visited_bitmap is only ever written in reduce_done(), which runs
    // strictly after compute() finishes for this round, so visited_bitmap is
    // guaranteed stable for the whole loop below. Any candidate gated by
    // visited_bitmap is an acceptable one-hop-closer parent regardless of
    // which local column supplies it (see the module docstring above), so
    // there's no ordering requirement across multiple hits on the same row --
    // whichever column is walked last for a given row wins, folded in
    // immediately per-hit rather than via a deferred compact-scratch merge.
    //
    // A two-pass split (boolean multiply, then a separate parent-tracking
    // pass) was tried to measure each half independently -- it showed the two
    // cost almost exactly the same (bool-multiply marginally larger), but
    // re-walking the same mat_col_idx_buf/mat_col_loc_buf/mat_col_len_buf/
    // mat_rows_buf structure a second time (no intermediate storage between
    // passes) inflated total_runtime_cycles by ~58% at the s12e16
    // balanced16x16 ch16 reference config, so it was reverted in favor of
    // this single fused pass.
    var i: u16 = 0;
    while (i < local_nnz_cols[0]) : (i += 1) {
        const c = mat_col_idx_buf[i];
        if ((x_bitmap[c >> 5] >> (c & 31)) & 1 != 0) {
            const loc = mat_col_loc_buf[i];
            const len = mat_col_len_buf[i];
            var j: u16 = 0;
            while (j < len) : (j += 1) {
                const k = mat_rows_buf[loc + j]; // dense row index, 0..blk-1
                y_bitmap[k >> 5] |= (@as(u32, 1) << (k & 31));
                if (is_iterative) {
                    // Store the LOCAL column index c directly, not the global vertex id
                    // (pcol_id*blk+c) -- keeps parent_local_buf/PARENT_NONE at u16 regardless
                    // of n, since c is always < blk (already independently bounded, see
                    // PARENT_NONE's own comment below). The global id is reconstructed
                    // host-side in device_io.py's extract_parent_result(), which already
                    // knows each slice's pcol_id from the readback layout.
                    if ((visited_bitmap[k >> 5] >> (k & 31)) & 1 == 0) {
                        parent_local_buf[k] = c;
                    }
                }
            }
        }
    }

    // TS_COMPUTE_EXPAND_ENTRY is recorded at the same point as
    // TS_REDUCE_ISSUE now -- there's no expand step left between them
    // (reduce_or below consumes y_bitmap directly), so local_compute_expand
    // reads ~0 cycles from here on. Kept (not deleted) for CSV/schema
    // continuity with existing timing runs; this is the honest reflection
    // of "this phase no longer does anything," not a bug.
    if (is_iterative) {
        record_ts(ts_round, TS_COMPUTE_EXPAND_ENTRY);
        record_ts(ts_round, TS_REDUCE_ISSUE);
    }

    // Phase 4: OR-reduce this row's local contributions toward its
    // diagonal -- reduce_or operates directly on y_bitmap's packed words,
    // no dense expansion needed (see y_bitmap_reduced's own comment).
    mpi_x.reduce_or(prow_id, &y_bitmap, &y_bitmap_reduced, BITMAP_WORDS, reduce_done_task_id);
}

task reduce_done() void {
    if (!is_iterative) {
        // Single SpMV End: all PEs exit
        sys_mod.unblock_cmd_stream();
        return;
    }

    record_ts(ts_round, TS_REDUCE_DONE);

    // Phase 5: local termination condition (output mask)
    if (pcol_id == prow_id) {
        //
        // Runs on EVERY round, including the last: if this only ran when
        // there's a next round to feed (like an unconditional copy would),
        // the final round's discoveries would never make it into
        // visited_bitmap, and x_bitmap would end the call holding stale data
        // from the second-to-last round instead of this round's actual
        // new nodes.
        //
        // Word-level, not bit-level: newly_word's zero bits are exactly the
        // rows that are either not hit this round or already visited, so a
        // single AND-NOT per word replaces a per-row bit test. Padding-bit
        // invariant holds automatically -- y_bitmap_reduced's padding is
        // always 0, so newly_word's padding is always 0 too (AND with
        // anything), and visited_bitmap/x_bitmap's padding stays 0
        // inductively (OR/assign of an always-0 value).
        nz_local[0] = 0.0;
        var w: u16 = 0;
        while (w < BITMAP_WORDS) : (w += 1) {
            const newly_word: u32 = y_bitmap_reduced[w] & ~visited_bitmap[w];
            if (newly_word != 0) {
                nz_local[0] = 1.0;
            }
            visited_bitmap[w] |= newly_word;
            x_bitmap[w] = newly_word;
        }
    }

    rounds_completed[0] += 1;
    record_ts(ts_round, TS_RELAY_ISSUE);

    // Phase 6: start termination check relay -- broadcast (not reduce)
    // rooted at pcol_id (this column's own diagonal PE), not MID: only the
    // diagonal ever has a real nz_local, so there's nothing to actually sum,
    // just a value to move. Functionally equivalent to the old
    // reduce_fadds(MID, ...) (every row ends up with the same value either
    // way) but considerably cheaper -- reduce_fadds is the only
    // <collectives_2d> primitive that needs BOTH fabric colors (see its own
    // module comment), and its teardown is a two-stage, every-PE-sends
    // handshake, versus broadcast's single-PE-sends/everyone-else-waits
    // teardown (compare collectives_2d/pe.csl's teardown_reduce_network()
    // and teardown_broadcast_network()).
    mpi_y.broadcast(pcol_id, @ptrcast([*]u32, &nz_local), 1, term_col_done_task_id);
}


// Column-broadcast (phase A, above) is needed from every column: each
// column's diagonal lives at a different row, and every column's own value
// must reach row MID.

// Only row MID does phases B/C for real, every other row skips straight to
// phase D and simply waits there.

// This is safe because mpi_x (phases B/C) and mpi_y (phase D) use separate fabric
// queues/colors, so row MID being mid-FSM in mpi_x doesn't block it from later joining
// mpi_y's phase D, and a non-root broadcast() participant genuinely
// blocks on its own fabric queue waiting for real data -- it doesn't
// require the root to have already called broadcast() first.
task term_col_done() void {

    record_ts(ts_round, TS_TERM_COL_DONE);
    // column-bcast done: every row now holds this column's shared value in
    // its own nz_local (phase 6's broadcast overwrote it in place)

    if (prow_id == MID) {
        // Phase 7: reduce the local term conditions on the (MID, MID) PE
        mpi_x.reduce_fadds(MID, @ptrcast([*]f32, &nz_local), @ptrcast([*]f32, &nz_total),
                            1, term_row_done_task_id);
    } else {
        // Non-MID PEs skip to Phase 9:
        record_ts(ts_round, TS_TERM_ROW_DONE);
        record_ts(ts_round, TS_TERM_ROW_BCAST_DONE);
        mpi_y.broadcast(MID, @ptrcast([*]u32, &nz_total), 1, term_col_bcast_done_task_id);
    }
}


task term_row_done() void {

    record_ts(ts_round, TS_TERM_ROW_DONE);
    // row-reduce done: (MID, MID) now holds final termination condition.
    
    // Phase 8: Flood it back out, row first...
    mpi_x.broadcast(MID, @ptrcast([*]u32, &nz_total), 1, term_row_bcast_done_task_id);
}

task term_row_bcast_done() void {

    record_ts(ts_round, TS_TERM_ROW_BCAST_DONE);
    // row-bcast done: al PEs on MID row hold the termination condition

    // Phase 9: bcast term condition on every col (non-MID PEs are already waiting)
    mpi_y.broadcast(MID, @ptrcast([*]u32, &nz_total), 1, term_col_bcast_done_task_id);
}

task term_col_bcast_done() void {

    record_ts(ts_round, TS_TERM_COL_BCAST_DONE);
    // col-bcast done: every PE now holds the termination condition
    
    // Check term condition    
    if (nz_total[0] != 0.0) {

        // rounds_completed[0] was already incremented (in reduce_done())
        ts_round = rounds_completed[0];
        record_ts(ts_round, TS_VBCAST_ISSUE);
        
        // Start with Phase 1 again: row-bcast updated visited bitmap
        mpi_x.broadcast(prow_id, &visited_bitmap, BITMAP_WORDS, visited_bcast_done_task_id);
   
    } else {
        sys_mod.unblock_cmd_stream();
    }
}

comptime {
    @bind_local_task(compute, compute_task_id);
    @bind_local_task(reduce_done, reduce_done_task_id);
    @bind_local_task(term_col_done, term_col_done_task_id);
    @bind_local_task(term_row_done, term_row_done_task_id);
    @bind_local_task(term_row_bcast_done, term_row_bcast_done_task_id);
    @bind_local_task(term_col_bcast_done, term_col_bcast_done_task_id);
    @bind_local_task(visited_bcast_done, visited_bcast_done_task_id);

    @export_symbol(ptr_x_bitmap, "x_bitmap");
    @export_symbol(ptr_y_bitmap_reduced, "y_bitmap_reduced");
    @export_symbol(ptr_visited_bitmap, "visited_bitmap");
    @export_symbol(ptr_rounds_completed, "rounds_completed");
    @export_symbol(ptr_parent_local_buf, "parent_local_buf");
    @export_symbol(ptr_mat_rows_buf, "mat_rows_buf");
    @export_symbol(ptr_mat_col_idx_buf, "mat_col_idx_buf");
    @export_symbol(ptr_mat_col_loc_buf, "mat_col_loc_buf");
    @export_symbol(ptr_mat_col_len_buf, "mat_col_len_buf");
    @export_symbol(ptr_local_nnz, "local_nnz");
    @export_symbol(ptr_local_nnz_cols, "local_nnz_cols");
    @export_symbol(ptr_local_nnz_rows, "local_nnz_rows");
    @export_symbol(ptr_tsc_start_buffer, "tsc_start_buffer");
    @export_symbol(ptr_tsc_end_buffer, "tsc_end_buffer");
    @export_symbol(ptr_ts_buf, "ts_buf");

    @export_symbol(f_spmv);
    @export_symbol(f_spmv_iter);
    @export_symbol(f_enable_tsc);
    @export_symbol(f_tic);
    @export_symbol(f_toc);
}
