// PE code for the standalone reduce_or() correctness test -- see
// layout_reduce_or_test.csl's own comment for the overall shape. Every PE
// seeds a host-supplied random [count]u32 send_buf, one row-wise
// mpi_x.reduce_or() call combines each row toward `root`'s column, and
// recv_buf is read back (meaningful only at the root column -- same
// "only the aggregation point's copy is real" convention bool_pe.csl uses).

param memcpy_params;
param c2d_params;
param count: u16;
param root: u16;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// local repo copy -- see layout_reduce_or_test.csl's own import comment for
// why this file lives directly in src/ rather than its own subdirectory.
const mpi_x = @import_module("./collectives_2d/pe.csl", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2, 4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1},
    });

var send_buf = @zeros([count]u32);
var recv_buf = @zeros([count]u32);

var ptr_send_buf: [*]u32 = &send_buf;
var ptr_recv_buf: [*]u32 = &recv_buf;

const reduce_done_task_id: local_task_id = @get_local_task_id(10);

task reduce_done() void {
    sys_mod.unblock_cmd_stream();
}

var mpi_initialized: bool = false;

fn f_run() void {
    if (!mpi_initialized) {
        mpi_x.init();
        mpi_initialized = true;
    }
    mpi_x.reduce_or(root, &send_buf, &recv_buf, count, reduce_done_task_id);
}

comptime {
    @bind_local_task(reduce_done, reduce_done_task_id);
    @export_symbol(ptr_send_buf, "send_buf");
    @export_symbol(ptr_recv_buf, "recv_buf");
    @export_symbol(f_run);
}
