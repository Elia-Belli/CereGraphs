// Boolean-semiring SpMV, one iteration, using collectives_2d (a local, in-tree
// copy -- see src/collectives_2d/, vendored from the container's <collectives_2d>
// stdlib so stage 2 of the bitmap work can add an OR-reduce without touching
// the system-wide module other kernels/examples import) instead of
// hand-rolled fabric routing (see gemv-collectives_2d/pe.csl for the
// reference pattern this follows).
//
// The matrix A (n-by-n, boolean) is partitioned into a P-by-P grid of PEs
// using the SAME hypersparse compressed-column format as hypersparse_spmv
// (mat_col_idx/loc/len_buf, mat_rows_buf) -- just without mat_vals_buf,
// since boolean semiring never uses edge weights. Unlike hypersparse_spmv,
// mat_rows_buf holds a direct dense row-block index (not a compact index
// into a separate distinct-row list) -- see y_bitmap's own comment below.
//
// Communication is targeted at the grid diagonal (pcol_id == prow_id) rather
// than a fixed corner:
//   - phase 1: mpi_y.broadcast(root=pcol_id, x_bitmap, ...) -- every PE in a
//     column receives the SAME x-block (packed as a bitmap), sourced from
//     that column's diagonal PE (row == pcol_id). Only the diagonal PE's
//     x_bitmap is seeded with real data (host memcpy); everyone else's is
//     overwritten by the broadcast.
//   - phase 2: mpi_x.reduce_or(root=prow_id, y_bitmap, y_bitmap_reduced, ...)
//     -- every PE in a row sends its local boolean contribution (packed as
//     a bitmap) toward that row's diagonal column (== prow_id), which ends
//     up holding the final, genuinely bitwise-OR'd result.
//
// This choice of diagonal target (instead of a scattered or corner-gathered
// result) is what lets a later BFS loop reuse phase 1 unmodified: the PE
// that produces row py's final result (the diagonal PE of that row) is
// exactly the PE that needs to source the next iteration's broadcast down
// its own column.
//
// f_spmv_iter runs this without a host round trip, masking each round's raw
// result against a cumulative visited_bitmap (see reduce_done()) before
// feeding it back as the next round's x -- i.e. only genuinely new
// discoveries propagate, same as sdk-hypersparse-spmv-bfs/run_bfs.py's host-side
// `new_mask = candidate & ~visited`. It stops once a 4-phase relay (see
// reduce_done()/term_col_done()/term_row_done()/term_row_bcast_done()/
// term_col_bcast_done()) agrees no row found anything new this round --
// no fixed round count, no host round trip anywhere in the loop.
// Convergence under visited-masking is monotonic (every round either finds
// >=1 new node or stops) and bounded by the node count, so this is
// guaranteed to terminate.
//
// Parent tracking (which vertex discovered a given node) can't use the
// row-reduce at all -- it's a combine (OR), not a selection, so it can't
// answer "which PE contributed" once more than one predecessor fires in the
// same round (see sdk-hypersparse-spmv-bfs/run_bfs.py's own docstring point 3 for the same
// limitation on the host-orchestrated version). Instead, parent is tracked
// per-PE, BEFORE the reduce (see compute()): every PE (i,j) in row i knows
// exactly which of its own local columns touched which local row this
// round, which the row-reduce's aggregation would otherwise throw away.
//
// A candidate is only ever recorded for a row that ISN'T YET VISITED (see
// the visited_bitmap bit-test in compute()) -- without that
// gate, a row that was already visited several rounds ago could still get
// touched by a later round's frontier (any node with a real structural
// edge into it, however many hops away that node actually is), silently
// overwriting a true one-hop-closer parent with an unrelated, invalid one
// whenever the later node's global index happened to be lower. Since no PE
// can ever see a hit on a row before that row's actual global discovery
// round (a hit at any PE immediately makes the row visited by the end of
// that same round, via the row-reduce all PEs share), gating on
// visited_bitmap restricts candidate recording to exactly a row's true
// discovery round -- gives a genuine, textbook one-hop-closer BFS parent,
// not merely a valid-but-arbitrary predecessor. This requires visited_bitmap
// (otherwise meaningful only at the diagonal PE, see its own comment
// below) to be distributed to every PE in the row before compute() runs
// each round -- see visited_bcast_done()/term_col_bcast_done() below.
//
// Each PE keeps parent_local_buf, indexed identically to x_bitmap/y_bitmap
// (dense over its row-block), holding a column it has recorded for each
// local row -- stored as the FULL GLOBAL vertex id (pcol_id*blk + local
// column), computed on-device at write time (Phase A of the on-device
// parent resolution plan -- previously this stored just the bare local
// column index, u16-safe at any n, with the global id reconstructed
// host-side instead; see git history / project memory for that older
// design if needed). The tie-break for multiple local columns hitting the
// same row in the same discovery round is intentionally NOT the lowest
// global index -- any candidate gated by visited_bitmap above is already a
// legal one-hop-closer parent, so there's no correctness reason to prefer
// the minimum one, and dropping that comparison saves a compare per
// row-hit (see the parent-tracking pass in compute() below: whichever
// local column is walked last for a given row wins). Because different
// PEs in the SAME row cover different column ranges, extract_parent_result()
// in ../device_io.py still combines each row's P per-PE candidates
// host-side after memcpy_d2h (via min(), for lack of any on-device
// min/select primitive -- <collectives_2d> has no min-reduce, though a
// select-any reduce is planned as a follow-up Phase B to move this
// combine on-device and shrink the d2h transfer) -- this remains correct
// since the min of several legal predecessors is itself a legal
// predecessor, even though it's no longer "the true global lowest index"
// in the old sense.

param memcpy_params;
param c2d_params;

param blk: u16;                 // per-PE dense vector chunk size = ceil(n/P)
param max_local_nnz: u16;       // max local number of nonzeros (matrix structure only, no vals)
param max_local_nnz_cols: u16;  // max local number of nonzero columns
param max_local_nnz_rows: u16;  // max local number of nonzero rows
param max_rounds: u16;          // upper bound on f_spmv_iter rounds profiled by ts_buf below
param tau_switch_count: u32;    // switch top-down -> bottom-up once nz_total exceeds this (see term_col_bcast_done())
                                 // u32 (not f32): cslc's --params CLI flag only accepts unsigned
                                 // integers, and this is always a whole vertex count anyway

const compute_task_id: local_task_id = @get_local_task_id(10);
const reduce_done_task_id: local_task_id = @get_local_task_id(11);
// termination-check relay (see reduce_done()/MID below) -- 14-17 are taken
// by <collectives_2d>'s own x/y entrypoints (see the map in layout_bool.csl).
const term_col_done_task_id: local_task_id = @get_local_task_id(12);
const term_row_done_task_id: local_task_id = @get_local_task_id(13);
const term_row_bcast_done_task_id: local_task_id = @get_local_task_id(18);
const term_col_bcast_done_task_id: local_task_id = @get_local_task_id(19);
// distributes visited_bitmap across each row before compute() runs -- see the
// module docstring above and visited_bcast_done() below.
const visited_bcast_done_task_id: local_task_id = @get_local_task_id(20);
// callback for the one-time, end-of-run parent resolution reduce (Phase B
// of the on-device parent resolution plan) -- see parent_resolve_done()
// below. id 21 (the naive next-free-slot guess after 10-20 above) was
// tried first and rejected by cslc itself at compile time ("task ID '21'
// bound to more than one task" -- memcpy's own LOCAL_MEMCPYD2H_DATA task,
// confirming layout_bool.csl's "21-23, 27-30, 33-37ish reserved by
// memcpy" comment for real, not just in theory). 24 confirmed free by the
// same real compile-time check.
const parent_resolve_done_task_id: local_task_id = @get_local_task_id(24);

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// tsc timing, bracketing just broadcast+compute+reduce (memcpy happens
// before f_tic is launched). No cross-PE clock-skew correction (unlike
// hypersparse_spmv's allreduce2R1E-based f_sync) -- for a quick relative
// comparison this is run with the same simplified methodology on both
// kernels, so the raw min/max is treated as directly comparable rather than
// as an absolute hardware-calibrated figure.
const timestamp = @import_module("<time>");
var tsc_start_buffer = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buffer = @zeros([timestamp.tsc_size_words]u16);

// Always-correct round-trip span markers, INDEPENDENT of max_rounds/ts_buf
// truncation (see record_ts()'s own max_rounds gate a few lines below --
// ts_buf simply has no slot to write into for any round >= max_rounds).
// round_trip_start_buffer is captured exactly once, at round 0's own
// TS_VBCAST_ISSUE (see start_spmv()); round_trip_done_buffer is captured
// unconditionally on EVERY round's TS_TERM_COL_BCAST_DONE (see
// term_col_bcast_done()), overwriting the same buffer each time -- so
// whatever round BFS actually converges on, this naturally ends up holding
// that TRUE final round's timestamp, never a truncated max_rounds-1 one.
// Fixes a real bug: total_runtime_cycles/search_time_cycles were silently
// WRONG (computed from round max_rounds-1's timestamp, not the true last
// round's) whenever rounds_completed > max_rounds -- see bfs_timing.py's
// compute_round_summary for the host-side fallback that now uses this
// pair instead in that case.
var round_trip_start_buffer = @zeros([timestamp.tsc_size_words]u16);
var round_trip_done_buffer = @zeros([timestamp.tsc_size_words]u16);

// Brackets transpose_structure()'s one-time cost (see term_col_bcast_done())
// explicitly, instead of leaving it as an unattributed gap inside
// total_runtime_cycles -- same raw-timestamp mechanism as record_ts()
// below, captured unconditionally (like record_ts already is) regardless
// of whether the host asked for full per-round timing; stays all-zero
// (tic==toc==0) if the switch never fires, which is itself the correct
// "no transpose happened" signal, not a bug. Per-PE, not a single scalar --
// local_nnz/local_nnz_rows vary per PE, so this is a real imbalance signal
// too, not just an aggregate cost.
var transpose_tic_buffer = @zeros([timestamp.tsc_size_words]u16);
var transpose_toc_buffer = @zeros([timestamp.tsc_size_words]u16);

// Same idea, for the one-time end-of-run mpi_x.reduce_select_any() call
// (Phase B of the on-device parent resolution plan, see
// term_col_bcast_done()'s termination branch) -- without this, its cost
// would be an unattributed gap the same way transpose's was before
// transpose_tic_buffer/toc_buffer existed: it runs strictly AFTER the last
// round's own TERM_COL_BCAST_DONE timestamp and BEFORE the host's own
// f_tic/f_toc d2h bracket even starts (f_spmv_iter's single blocking
// launch doesn't return to the host until this reduce has also finished),
// so none of decode_phase_row's per-round windows span it and it would
// otherwise silently understate search_time_cycles/GTEPS. Unlike
// transpose, this always fires exactly once per is_iterative run (not
// conditionally), so tic/toc are captured unconditionally around the
// reduce_select_any call itself, not around a maybe-skipped branch --
// tic is captured right before issuing the (async) reduce, toc inside its
// callback (parent_resolve_done()), so this correctly measures the whole
// async operation's wall-clock span, not just the issuing call's own
// (near-instant) return.
var parent_resolve_tic_buffer = @zeros([timestamp.tsc_size_words]u16);
var parent_resolve_toc_buffer = @zeros([timestamp.tsc_size_words]u16);

// Per-round timing (f_spmv_iter only -- see record_ts() below). One raw
// hardware timestamp is captured at each of these round-boundary points;
// host-side (bfs_timing.py, used by run_bfs.py) subtracts consecutive
// pairs (as 48-bit values, cerebras.sdk.sdk_utils.make_u48) to get
// local_compute/local_term_cond's elapsed cycles (max across PEs once
// every PE's copy is read back), and TS_VBCAST_ISSUE/TS_TERM_COL_BCAST_DONE
// additionally bound the whole round (round_time, see compute_round_summary
// in bfs_timing.py). This buffer used to also bracket the individual
// communication phases (visited_bcast/vertical_bcast/reduce/relay) for a
// skew-adjustment scheme that was found unreliable and removed (see
// GRAPH500_BENCHMARK.md) -- only the two REAL local-work phases (compute,
// term_cond) and the two round-boundary markers survive:
//   0 TS_VBCAST_ISSUE        -- before mpi_x.broadcast(visited_bitmap); round start
//   1 TS_COMPUTE_ENTRY       -- entry of compute(); local compute start
//   2 TS_REDUCE_ISSUE        -- before mpi_x.reduce_or in compute(); local compute end
//   3 TS_REDUCE_DONE         -- entry of reduce_done(); local term-cond start
//   4 TS_RELAY_ISSUE         -- before mpi_y.broadcast(nz_local) in reduce_done(); local term-cond end
//   5 TS_TERM_COL_BCAST_DONE -- entry of term_col_bcast_done(); round end
const TS_VBCAST_ISSUE: u16 = 0;
const TS_COMPUTE_ENTRY: u16 = 1;
const TS_REDUCE_ISSUE: u16 = 2;
const TS_REDUCE_DONE: u16 = 3;
const TS_RELAY_ISSUE: u16 = 4;
const TS_TERM_COL_BCAST_DONE: u16 = 5;
const NUM_TS_SLOTS: u16 = 6;

// flat [max_rounds][NUM_TS_SLOTS][3]u16, row-major (round slowest, then
// slot, then the 3 raw timestamp words) -- see record_ts() for the index
// arithmetic. No per-call reset needed: the host only ever reads the
// [0, rounds_completed) prefix (see ../run_bfs.py), so stale entries
// from a longer PRIOR run past the current run's rounds_completed are
// simply never looked at.
var ts_buf = @zeros([max_rounds * NUM_TS_SLOTS * 3]u16);

// Phase D telemetry (direction-optimizing BFS, see the plan): per-round
// frontier size (nf_history[r] == nz_total at the end of round r, i.e. the
// number of vertices round r itself discovered) and which traversal
// strategy round r actually used (direction_history[r], 0=top-down/
// 1=bottom-up) -- lets a host script label each round's own
// local_compute-family timing with the direction that produced it, instead
// of only knowing the aggregate hybrid-vs-pure-top-down difference. Same
// max_rounds-bounded sizing/truncation convention as ts_buf above.
var nf_history = @zeros([max_rounds]u32);
var direction_history = @zeros([max_rounds]u16);
var ts_scratch = @zeros([timestamp.tsc_size_words]u16);
// which round record_ts() below should file its captures under -- see the
// two assignment sites (start_spmv(), term_col_bcast_done()) for why this
// can't just be rounds_completed[0] directly (that counter increments
// mid-round, in reduce_done(), before the relay phases' own captures).
var ts_round: u16 = 0;

fn record_ts(round: u16, slot: u16) void {
    if (round < max_rounds) {
        timestamp.get_timestamp(&ts_scratch);
        const base: u16 = (round * NUM_TS_SLOTS + slot) * 3;
        ts_buf[base] = ts_scratch[0];
        ts_buf[base + 1] = ts_scratch[1];
        ts_buf[base + 2] = ts_scratch[2];
    }
}

// queues/dsr_ids mirror gemm-collectives_2d/pe.csl -- they don't conflict
// with memcpy's queue 0.
//
// Local repo copy (bool_diag_spmv/src/collectives_2d/), not the container's
// <collectives_2d> -- vendored in-tree so stage 2 of the bitmap work (an
// OR-reduce, and whatever broadcast adjustments it needs) can be
// experimented on freely without touching the system-wide stdlib module
// that other kernels/examples also import.
const mpi_x = @import_module("./collectives_2d/pe.csl", .{
    .dim_params = c2d_params.x,
    .queues = [2]u16{2, 4},
    .dest_dsr_ids = [1]u16{1},
    .src0_dsr_ids = [1]u16{1},
    .src1_dsr_ids = [1]u16{1},
    });
const mpi_y = @import_module("./collectives_2d/pe.csl", .{
    .dim_params = c2d_params.y,
    .queues = [2]u16{3, 5},
    .dest_dsr_ids = [1]u16{2},
    .src0_dsr_ids = [1]u16{2},
    .src1_dsr_ids = [1]u16{2},
    });

// matrix structure, populated per-PE by run_single_spmv.py/run_bfs.py via
// memcpy (hypersparse compressed-column format, identical to
// hypersparse_spmv minus mat_vals_buf)
var mat_rows_buf = @zeros([max_local_nnz]u16);
var mat_col_idx_buf = @zeros([max_local_nnz_cols]u16);
var mat_col_loc_buf = @zeros([max_local_nnz_cols]u16);
var mat_col_len_buf = @zeros([max_local_nnz_cols]u16);

var local_nnz = @zeros([1]u16);
var local_nnz_cols = @zeros([1]u16);
var local_nnz_rows = @zeros([1]u16);

// Phase B (direction-optimizing BFS, see the plan): CSR-by-destination
// mirror of mat_col_idx/loc/len_buf, built ON-DEVICE by transpose_structure()
// the one time is_bottom_up flips true -- never shipped from the host.
// mat_row_idx_buf[nnz_rows] lists this PE's distinct nonzero LOCAL rows
// (mirrors mat_col_idx_buf); mat_row_loc_buf/mat_row_len_buf are its
// prefix-sum/degree pair (mirrors mat_col_loc_buf/mat_col_len_buf) into...
// mat_rows_buf itself, REUSED IN PLACE: transpose_structure() overwrites it
// to hold SOURCE COLUMN values grouped by row, instead of destination row
// values grouped by column -- see its own comment for why this needs no
// second [max_local_nnz]-sized array. local_nnz_rows[0] (already existing,
// today host-shipped) is overwritten with the on-device recount as a
// byproduct, so it's guaranteed self-consistent with these new buffers.
var mat_row_idx_buf = @zeros([max_local_nnz_rows]u16);
var mat_row_loc_buf = @zeros([max_local_nnz_rows]u16);
var mat_row_len_buf = @zeros([max_local_nnz_rows]u16);

// row_to_bucket: dense [blk] map from a row VALUE to its bucket index into
// mat_row_idx/loc/len_buf (ROW_BUCKET_NONE if that row has no local nonzero
// entries) -- blk-sized, not nnz-sized, so this is cheap relative to the
// full second data array a naive dual-structure design would need. Doubles
// as scratch for the row-degree histogram during transpose_structure()'s
// counting pass, before being overwritten in place with real bucket
// indices (see its own comment there).
var row_to_bucket = @zeros([blk]u16);
const ROW_BUCKET_NONE: u16 = 65535;

// cursor_buf: mutable working copy of mat_row_loc_buf, advanced by
// transpose_structure()'s cycle-leader scatter as it places each element
// into the next free slot of its target row-bucket.
var cursor_buf = @zeros([max_local_nnz_rows]u16);

// visited_pos: 1 bit per OLD (column-grouped) position in mat_rows_buf,
// tracking which have already been permuted to their final row-grouped
// slot -- this plus cursor_buf/row_to_bucket above is the ENTIRE extra
// memory transpose_structure() needs; no [max_local_nnz]-sized duplicate.
const NNZ_BITMAP_WORDS: u16 = (max_local_nnz + 31) / 32;
var visited_pos = @zeros([NNZ_BITMAP_WORDS]u32);

// Real termination check (see reduce_done()): <collectives_2d> only gives
// us per-row (mpi_x) or per-column (mpi_y) primitives, never "the
// diagonal" directly, so reaching from one diagonal PE to another always
// means relaying through a full row AND a full column. That forces a
// 4-phase relay -- column-broadcast (rooted at each column's own diagonal,
// not MID -- only the diagonal ever has real data, so this moves it rather
// than reducing it), row-reduce, row-broadcast, column-broadcast (these
// last three still rooted at MID on both axes) -- which lands the
// aggregation point at (MID, MID): itself a diagonal PE, and (for the
// three MID-rooted phases) the position that minimizes each phase's
// worst-case chain latency (max(root, P-1-root) hops, per <collectives_2d>'s
// own linear-chain implementation).
// The middle two phases (row-reduce, row-broadcast) are only ever real
// work for row MID -- every other row's own copy would combine/broadcast
// data nobody reads, so term_col_done() has them skip straight to the
// last phase instead (see its own comment).
const P: u16 = @get_rectangle().width;
const MID: u16 = P / 2;

// nz_local: this round's local "did I find anything new" flag, real only
// at the diagonal PE (pcol_id == prow_id) -- every other row's own value
// is always 0, so phase 6 (below) is a broadcast, not a reduce: nothing
// to sum, just move the diagonal's one real value to the rest of the
// column. After that broadcast, every row's own nz_local holds the same
// (that column's) shared value -- no separate nz_col buffer needed.
// nz_total: after the row-reduce, meaningful only at (MID, MID). Since
// stage "direction-optimizing BFS" (see the plan), nz_local/nz_total hold a
// POPCOUNT (this round's newly-discovered vertex count), not a 0/1 flag --
// see reduce_done()'s own comment. reduce_fadds still just sums whatever's
// in nz_local, so nz_total ends up exactly Beamer's nf (next round's
// frontier size), flooded to every PE by the existing relay at zero added
// communication cost. Termination is still "nz_total == 0" either way.
var nz_local = @zeros([1]f32);
var nz_total = @zeros([1]f32); // termination condition (and, since >0, next round's frontier size nf)

// is_bottom_up: this run's current BFS traversal strategy (Beamer et al.,
// SC 2012 -- top-down/push vs. bottom-up/pull), decided once nz_total
// crosses tau_switch_count (see term_col_bcast_done()). Deliberately named
// to avoid a bare "direction" -- <collectives_2d>'s own POS_DIR/NEG_DIR
// (imported above via mpi_x/mpi_y) is an unrelated fabric-routing-direction
// concept internal to the broadcast/reduce FSMs, not this traversal
// strategy. Switching is one-way (top-down -> bottom-up only, never back)
// by design: this is what lets the transposed structure it requires be
// built in place instead of duplicated (see the plan).
var is_bottom_up: bool = false;
// Temporary debug mirror of is_bottom_up (u16, host-readable) for
// validating the switch threshold against real graphs before the
// bottom-up compute path (Phase B/C) exists -- see the plan's Phase A.
var is_bottom_up_dbg = @zeros([1]u16);

// rounds_completed: host-visible counter of how many rounds f_spmv_iter
// actually ran this call, purely for verifying early termination actually
// happens (see ../run_host_driven_bfs.py) -- not read by the kernel itself.
var rounds_completed = @zeros([1]u16);

// y_bitmap: dense per-PE bitmap over this PE's row-block (bit k == row k of
// blk, matching x_bitmap's own indexing), set by the local multiply below and
// fed directly into reduce_or as its send buffer -- see compute(). Replaces
// the old compact-index y_flags/y_rows_init_buf scheme -- mat_rows_buf now
// gives a dense row index directly (see preprocess_bool.py), so there is
// no compact index space to maintain.
//
// Layout: word_idx = k >> 5, bit_idx = k & 31 -- every word covers 32 rows
// except possibly the last, which is partial whenever blk % 32 != 0.
// Invariant (relied on by reduce_or's own OR-reduce over these words):
// any bit at position >= blk (i.e. past the last real row, within the last
// word) is ALWAYS 0 -- the reset below zeroes it, and the only bit-set site
// uses `k` values that always come from mat_rows_buf, which is
// host-populated from real structural rows and therefore always < blk.
// Never explicitly masked; true by construction.
const BITMAP_WORDS: u16 = (blk + 31) / 32;

// x_bitmap: this PE's dense column-block of x, packed the same way
// y_bitmap is (bit k == column k of blk). Broadcast() is dtype-agnostic
// (confirmed stage 2a), so this needs no @ptrcast at its broadcast call
// sites -- just BITMAP_WORDS instead of blk as the element count.
var x_bitmap = @zeros([BITMAP_WORDS]u32);

// visited_bitmap: cumulative "ever discovered" set for f_spmv_iter, packed
// the same way, indexed identically to x_bitmap (same row/column block).
// Real writes only ever happen at the diagonal PE: seeded from the initial
// x_bitmap in start_spmv(), OR'd with every round's genuinely-new
// discoveries in reduce_done(). Every other PE in the row gets a fresh copy
// each round via visited_bcast_done() (same "only the diagonal's copy is
// real, broadcast overwrites everyone else's" convention x_bitmap already
// uses) -- compute() needs this at every PE to gate parent tracking (see
// the module docstring above). Never used or touched by plain f_spmv (see
// the is_iterative guards below).
var visited_bitmap = @zeros([BITMAP_WORDS]u32);

var y_bitmap = @zeros([BITMAP_WORDS]u32);

// y_bitmap_reduced: final row-block result after reduce_or, packed the same
// way y_bitmap is. Separate memory from y_bitmap -- reduce_or's own
// internal FSM assumes send/recv buffers are independent (e.g. the root
// PE's own-copy merge step reads both), so they must not alias. Replaces
// the old dense-f32 y_buf (and the y_local_buf send-side copy it needed)
// now that the row-reduce operates directly on the bitmap. The host reads
// back the full rectangle and keeps only the diagonal entries (see
// device_io.unpack_bitmap_to_dense/extract_diag_result).
var y_bitmap_reduced = @zeros([BITMAP_WORDS]u32);

// Fast dense-buffer reset: a single DSD op per buffer instead of a
// BITMAP_WORDS-iteration scalar while loop. zero_scalar_u32 is a permanent
// one-element zero source (written once at load, never again); fill_bitmap_u32
// reads that same element `extent`-many times (stride 0, a broadcast read)
// so @mov32 can stream a whole buffer's worth of zeros in one
// hardware-driven pass, exploiting the tensor engine's SIMD streaming
// instead of per-element scalar stores. Comptime (BITMAP_WORDS is a
// compile-time param-derived constant), so built once at module scope and
// reused unchanged every round.
var zero_scalar_u32 = @zeros([1]u32);
const fill_bitmap_u32 = @get_dsd(mem1d_dsd, .{ .base_address = &zero_scalar_u32, .extent = BITMAP_WORDS, .stride = 0 });
const y_bitmap_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &y_bitmap, .extent = BITMAP_WORDS });
const y_bitmap_reduced_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &y_bitmap_reduced, .extent = BITMAP_WORDS });

// Same fast-reset trick, for transpose_structure()'s own two scratch
// buffers (see the plan's Phase B) -- row_to_bucket is u16 (needs its own
// zero_scalar_u16, since @mov16/@mov32 aren't interchangeable on element
// width), visited_pos is u32 and reuses zero_scalar_u32 above directly
// (same value, just a different extent than fill_bitmap_u32's).
var zero_scalar_u16 = @zeros([1]u16);
const fill_row_to_bucket_u16 = @get_dsd(mem1d_dsd, .{ .base_address = &zero_scalar_u16, .extent = blk, .stride = 0 });
const row_to_bucket_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &row_to_bucket, .extent = blk });
const fill_visited_pos_u32 = @get_dsd(mem1d_dsd, .{ .base_address = &zero_scalar_u32, .extent = NNZ_BITMAP_WORDS, .stride = 0 });
const visited_pos_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &visited_pos, .extent = NNZ_BITMAP_WORDS });

// Popcount support for reduce_done()'s nf computation: @popcnt (like
// @or16/@and16) is 16-bit-granularity only, no @popcnt32 -- same
// u16-view-of-a-u32-buffer trick reduce_or's own transfer_data_reduce_or()
// uses (collectives_2d/pe.csl). @ptrcast can't be used inside a comptime
// DSD-construction struct literal ("comptime pointer cast is not
// supported") -- mirror collectives_2d's own workaround instead: build the
// DSD with a harmless placeholder base address at module scope, then
// retarget it to x_bitmap's u16 view via @set_dsd_base_addr at runtime
// (see start_spmv()'s one-time-init block) -- @ptrcast is fine there,
// same as collectives_2d's own mem16 = @set_dsd_base_addr(mem16,
// @ptrcast(...)) call sites.
var popcnt_scratch = @zeros([2 * BITMAP_WORDS]u16);
var popcnt_src_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &popcnt_scratch, .extent = 2 * BITMAP_WORDS });
const popcnt_dst_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &popcnt_scratch, .extent = 2 * BITMAP_WORDS });

// sentinel meaning "no candidate parent seen". Phase A of the u32
// global-id migration (see the-poster-submission's on-device parent
// resolution plan): parent_local_buf now stores the FULL global vertex id
// (pcol_id*blk + local column), not a local column index, so this sentinel
// must exceed the max real GLOBAL vertex id (n-1), not just blk-1 --
// widened to u32::MAX accordingly. Safe since n <= P*blk, comfortably under
// u32 range per preprocess_bool.py's own blk < u16::max assertion.
const PARENT_NONE: u32 = 4294967295;

// parent_local_buf: this PE's own candidate parent, dense over its
// row-block like x_bitmap, PERSISTED across rounds (never reset
// except at a fresh f_spmv_iter call in start_spmv()) -- holds the FULL
// GLOBAL vertex id (pcol_id*blk + local column) this PE has recorded for
// each local row, across every round. Widened from a local-column-index-only
// u16 encoding (Phase A of the on-device parent resolution plan) to a u32
// global id (Phase A), and now (Phase B) the send_buf for a one-time,
// end-of-run mpi_x.reduce_select_any() call (see term_col_bcast_done()
// below) that resolves each row's P per-PE candidates down to a single
// winner AT PE-COLUMN 0 -- host readback only needs parent_relay_result's
// column-0 slice afterward, cutting the d2h transfer P-fold versus reading
// back every column's independent copy (see device_io.py's
// extract_parent_result(), now much simpler since the per-row combine
// happens here instead of host-side).
var parent_local_buf = @zeros([blk]u32);
// recv_buf for the parent-resolution reduce -- meaningful ONLY at PE-column
// 0 after f_spmv_iter converges (every other column's copy is a
// non-root reduce participant, same "only the aggregation point's copy is
// real" convention y_bitmap_reduced already uses for the diagonal).
// No third scratch buffer needed -- reduce_select_any's own in-place
// design (see its comment in collectives_2d/pe.csl) reuses
// parent_local_buf's memory as the landing zone for a middle root's
// second incoming side once its original value has already been merged
// into parent_relay_result, and reuses each non-root PE's own
// parent_relay_result as its landing zone (otherwise entirely unused on
// non-root PEs). Only 2 buffers total, matching reduce_or/reduce_fadds.
var parent_relay_result = @zeros([blk]u32);

var ptr_x_bitmap: [*]u32 = &x_bitmap;
var ptr_y_bitmap_reduced: [*]u32 = &y_bitmap_reduced;
var ptr_visited_bitmap: [*]u32 = &visited_bitmap;
var ptr_rounds_completed: [*]u16 = &rounds_completed;
var ptr_parent_relay_result: [*]u32 = &parent_relay_result;
var ptr_mat_rows_buf: [*]u16 = &mat_rows_buf;
var ptr_mat_col_idx_buf: [*]u16 = &mat_col_idx_buf;
var ptr_mat_col_loc_buf: [*]u16 = &mat_col_loc_buf;
var ptr_mat_col_len_buf: [*]u16 = &mat_col_len_buf;
var ptr_local_nnz: [*]u16 = &local_nnz;
var ptr_local_nnz_cols: [*]u16 = &local_nnz_cols;
var ptr_local_nnz_rows: [*]u16 = &local_nnz_rows;
// Temporary debug exports for Phase B validation (see the plan / the
// dedicated run_transpose_device_test.py) -- let a host script read back
// transpose_structure()'s output and cross-check it against the
// already-validated Python prototype.
var ptr_mat_row_idx_buf: [*]u16 = &mat_row_idx_buf;
var ptr_mat_row_loc_buf: [*]u16 = &mat_row_loc_buf;
var ptr_mat_row_len_buf: [*]u16 = &mat_row_len_buf;
// Temporary debug exports for Phase A validation (see the plan) -- nz_total
// is Beamer's nf on the last completed round; is_bottom_up_dbg mirrors
// is_bottom_up. Both let a host script confirm the switch threshold fires
// where expected before the bottom-up compute path exists.
var ptr_nz_total: [*]f32 = &nz_total;
var ptr_is_bottom_up_dbg: [*]u16 = &is_bottom_up_dbg;

var ptr_tsc_start_buffer: [*]u16 = &tsc_start_buffer;
var ptr_tsc_end_buffer: [*]u16 = &tsc_end_buffer;
var ptr_transpose_tic_buffer: [*]u16 = &transpose_tic_buffer;
var ptr_transpose_toc_buffer: [*]u16 = &transpose_toc_buffer;
var ptr_round_trip_start_buffer: [*]u16 = &round_trip_start_buffer;
var ptr_round_trip_done_buffer: [*]u16 = &round_trip_done_buffer;
var ptr_parent_resolve_tic_buffer: [*]u16 = &parent_resolve_tic_buffer;
var ptr_parent_resolve_toc_buffer: [*]u16 = &parent_resolve_toc_buffer;
var ptr_ts_buf: [*]u16 = &ts_buf;
var ptr_nf_history: [*]u32 = &nf_history;
var ptr_direction_history: [*]u16 = &direction_history;

var pcol_id: u16;
var prow_id: u16;

// mpi_x/mpi_y.init() only needs to run per device session, not per launch
var mpi_initialized: bool = false;

// true for f_spmv_iter calls (masking/visited/termination-relay logic
// applies), false for plain f_spmv (always exactly one round, untouched).
var is_iterative: bool = false;

fn f_enable_tsc() void {
    timestamp.enable_tsc();
    sys_mod.unblock_cmd_stream();
}

fn f_tic() void {
    timestamp.get_timestamp(&tsc_start_buffer);
    sys_mod.unblock_cmd_stream();
}

fn f_toc() void {
    timestamp.get_timestamp(&tsc_end_buffer);
    sys_mod.unblock_cmd_stream();
}

fn start_spmv() void {
    if (!mpi_initialized) {
        mpi_x.init();
        mpi_y.init();
        mpi_initialized = true;
        // one-time retarget of popcnt_src_dsd to x_bitmap's u16 view (see
        // its own declaration comment) -- x_bitmap's address never changes
        // for the life of this kernel, so this only needs to happen once.
        popcnt_src_dsd = @set_dsd_base_addr(popcnt_src_dsd, @ptrcast([*]u16, &x_bitmap));
    }
    pcol_id = mpi_x.pe_id;
    prow_id = mpi_y.pe_id;

    // At the start of new BFS: 
    // - Reset the visited as the new x
    // - Reset the parent_local_buf to PARENT_NONE
    if (is_iterative and pcol_id == prow_id) {

        var w: u16 = 0;
        while (w < BITMAP_WORDS) : (w += 1)
        {
            visited_bitmap[w] = x_bitmap[w];
        }
    }
    if (is_iterative) {

        var p: u16 = 0;
        while (p < blk) : (p += 1)
        {
            parent_local_buf[p] = PARENT_NONE;
        }

        // Every fresh BFS must start top-down: nf at the root is always far
        // below tau_switch_count anyway, but relying on that implicitly
        // instead of an explicit reset would be fragile (and see
        // is_bottom_up's own comment for why this can only ever flip once
        // per call).
        is_bottom_up = false;
        is_bottom_up_dbg[0] = 0;
    }


    // Start the first round of SpMV (or the next round of iterative SpMV)
    if (is_iterative) {

        rounds_completed[0] = 0;
        ts_round = rounds_completed[0];
        record_ts(ts_round, TS_VBCAST_ISSUE);
        // Unconditional (not max_rounds-gated) -- see round_trip_start_buffer's
        // own declaration comment. Runs exactly once, right here, since
        // start_spmv() only ever begins round 0 once per f_spmv_iter call.
        timestamp.get_timestamp(&round_trip_start_buffer);
        if (ts_round < max_rounds) {
            direction_history[ts_round] = 0; // round 0 always starts top-down
        }

        // Phase 1: broadcast visited bitmap along each row (needed for parent tracking)
        mpi_x.broadcast(prow_id, &visited_bitmap, BITMAP_WORDS, visited_bcast_done_task_id);

    } else {
        // SpMV: just broadcast x_bitmap down the column
        mpi_y.broadcast(pcol_id, &x_bitmap, BITMAP_WORDS, compute_task_id);
    }
}

task visited_bcast_done() void {
    // Phase 2: broadcast x_bitmap down the column
    mpi_y.broadcast(pcol_id, &x_bitmap, BITMAP_WORDS, compute_task_id);
}

// compute y = A*x, one iteration, boolean semiring, reduce to the diagonal
fn f_spmv() void {
    is_iterative = false;
    start_spmv();
}

// same as f_spmv, but after reducing to the diagonal, copies y back into x
// (broadcasting it again down the diagonal's column) and repeats until the
// termination relay (see reduce_done()) agrees no row found anything new --
// i.e. the output of each round becomes the next round's input vector, for
// as many rounds as real BFS convergence takes, before returning control to
// the host.
fn f_spmv_iter() void {
    is_iterative = true;
    start_spmv();
}

// col_of(p): which column-group OLD (column-grouped) position p belongs to
// -- mat_col_loc_buf is strictly increasing (every listed column has
// degree >= 1), so this is a plain binary search for the largest i with
// mat_col_loc_buf[i] <= p. Used only by transpose_structure()'s cycle
// jumps below, which visit positions in scattered (non-sequential) order --
// a sequential running-boundary trick isn't available there, and
// precomputing this for every p would need an [max_local_nnz]-sized array,
// exactly the duplicate this whole design avoids (see the plan).
fn col_of(p: u16) u16 {
    var lo: u16 = 0;
    var hi: u16 = local_nnz_cols[0]; // exclusive upper bound
    while (hi - lo > 1) {
        const mid: u16 = lo + (hi - lo) / 2;
        if (mat_col_loc_buf[mid] <= p) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return mat_col_idx_buf[lo];
}

// transpose_structure(): one-time in-place transpose of this PE's local
// CSC-by-source block (mat_col_idx/loc/len_buf + mat_rows_buf) into a
// CSR-by-destination block (mat_row_idx/loc/len_buf + mat_rows_buf, the
// LATTER REUSED IN PLACE) -- see the plan's Phase B and this file's own
// buffer-declaration comments above. Called exactly once, synchronously,
// from term_col_bcast_done() the moment is_bottom_up flips true -- pure
// local computation, no fabric traffic, so a plain fn (not a task) is
// enough; the caller only needs to not proceed to the next round's
// compute() until this returns.
fn transpose_structure() void {
    const nnz: u16 = local_nnz[0];

    // --- counting pass: row-degree histogram, using row_to_bucket as
    // scratch degree storage before it holds real bucket indices ---
    @mov16(row_to_bucket_dsd, fill_row_to_bucket_u16);
    var p: u16 = 0;
    while (p < nnz) : (p += 1) {
        row_to_bucket[mat_rows_buf[p]] += 1;
    }

    var nrows: u16 = 0;
    var running: u16 = 0;
    var r: u16 = 0;
    while (r < blk) : (r += 1) {
        const deg = row_to_bucket[r];
        if (deg != 0) {
            mat_row_idx_buf[nrows] = r;
            mat_row_loc_buf[nrows] = running;
            mat_row_len_buf[nrows] = deg;
            cursor_buf[nrows] = running;
            row_to_bucket[r] = nrows; // now a bucket index, not a degree
            running += deg;
            nrows += 1;
        } else {
            row_to_bucket[r] = ROW_BUCKET_NONE;
        }
    }
    local_nnz_rows[0] = nrows; // on-device recount; self-consistent with the buffers above

    // --- cycle-leader in-place scatter (see the plan's own writeup for the
    // full derivation -- this permutes POSITIONS via each element's row
    // value, but writes COLUMN values, not row values, at each target) ---
    @mov32(visited_pos_dsd, fill_visited_pos_u32);

    var p0: u16 = 0;
    while (p0 < nnz) : (p0 += 1) {
        if ((visited_pos[p0 >> 5] >> (p0 & 31)) & 1 != 0) {
            continue;
        }
        var r_cur: u16 = mat_rows_buf[p0];
        var c_cur: u16 = col_of(p0);
        visited_pos[p0 >> 5] |= (@as(u32, 1) << (p0 & 31));
        while (true) {
            const b: u16 = row_to_bucket[r_cur];
            const target: u16 = cursor_buf[b];
            cursor_buf[b] += 1;
            if ((visited_pos[target >> 5] >> (target & 31)) & 1 != 0) {
                // closes the cycle -- target must be p0 (the only position
                // this cycle could still map onto that we haven't already
                // freshly marked visited above)
                mat_rows_buf[target] = c_cur;
                break;
            }
            const r_next: u16 = mat_rows_buf[target];
            const c_next: u16 = col_of(target);
            mat_rows_buf[target] = c_cur;
            visited_pos[target >> 5] |= (@as(u32, 1) << (target & 31));
            r_cur = r_next;
            c_cur = c_next;
        }
    }
}

// compute() runs once per round
// compute_topdown(): Phase 3 local boolean multiply (push) -- for every
// locally-nonzero column c with x_bitmap's bit c set, set the bit for
// every local (dense) row it touches. Also merges a candidate parent
// directly into the persistent parent_local_buf -- inline, no separate
// per-round scratch buffer -- BEFORE the reduce (in compute()) discards
// column identity. This is safe because visited_bitmap is only ever
// written in reduce_done(), which runs strictly after compute() finishes
// for this round, so visited_bitmap is guaranteed stable for the whole
// loop below. Any candidate gated by visited_bitmap is an acceptable
// one-hop-closer parent regardless of which local column supplies it (see
// the module docstring above), so there's no ordering requirement across
// multiple hits on the same row -- whichever column is walked last for a
// given row wins, folded in immediately per-hit rather than via a deferred
// compact-scratch merge.
//
// A two-pass split (boolean multiply, then a separate parent-tracking
// pass) was tried to measure each half independently -- it showed the two
// cost almost exactly the same (bool-multiply marginally larger), but
// re-walking the same mat_col_idx_buf/mat_col_loc_buf/mat_col_len_buf/
// mat_rows_buf structure a second time (no intermediate storage between
// passes) inflated total_runtime_cycles by ~58% at the s12e16
// balanced16x16 ch16 reference config, so it was reverted in favor of this
// single fused pass.
fn compute_topdown() void {
    var i: u16 = 0;
    while (i < local_nnz_cols[0]) : (i += 1) {
        const c = mat_col_idx_buf[i];
        if ((x_bitmap[c >> 5] >> (c & 31)) & 1 != 0) {
            const loc = mat_col_loc_buf[i];
            const len = mat_col_len_buf[i];
            var j: u16 = 0;
            while (j < len) : (j += 1) {
                const k = mat_rows_buf[loc + j]; // dense row index, 0..blk-1
                y_bitmap[k >> 5] |= (@as(u32, 1) << (k & 31));
                if (is_iterative) {
                    // Compute the FULL global vertex id on-device (Phase A of the
                    // u32 migration) instead of storing the bare local column index --
                    // pcol_id/blk are u16, so the product must be done in u32 arithmetic
                    // to avoid silently truncating for any pcol_id*blk >= 65536.
                    if ((visited_bitmap[k >> 5] >> (k & 31)) & 1 == 0) {
                        const global_c: u32 = @as(u32, pcol_id) * @as(u32, blk) + @as(u32, c);
                        parent_local_buf[k] = global_c;
                    }
                }
            }
        }
    }
}

// compute_bottomup(): the pull counterpart, used only after transpose_structure()
// has run (see the plan's Phase B/is_bottom_up's own comment) -- iterates
// this PE's locally-nonzero destination ROWS instead of source columns, and
// for each not-yet-visited row, stops at the FIRST frontier column it finds
// (the actual bottom-up efficiency win: unlike compute_topdown(), which
// always walks every row a frontier column touches regardless of that
// row's visited state, this skips a row's remaining columns as soon as one
// hit is found). mat_rows_buf here holds SOURCE COLUMN values grouped by
// row -- transpose_structure()'s in-place repurposing of its own memory,
// not a second array (see mat_row_idx_buf's own declaration comment).
fn compute_bottomup() void {
    var i: u16 = 0;
    while (i < local_nnz_rows[0]) : (i += 1) {
        const r = mat_row_idx_buf[i];
        if ((visited_bitmap[r >> 5] >> (r & 31)) & 1 != 0) {
            continue; // already discovered -- skip this row's columns entirely
        }
        const loc = mat_row_loc_buf[i];
        const len = mat_row_len_buf[i];
        var j: u16 = 0;
        while (j < len) : (j += 1) {
            const c = mat_rows_buf[loc + j]; // source column, post-transpose
            if ((x_bitmap[c >> 5] >> (c & 31)) & 1 != 0) {
                y_bitmap[r >> 5] |= (@as(u32, 1) << (r & 31));
                if (is_iterative) {
                    // See compute_topdown()'s matching comment -- same global-id
                    // computation, u32 arithmetic required.
                    const global_c: u32 = @as(u32, pcol_id) * @as(u32, blk) + @as(u32, c);
                    parent_local_buf[r] = global_c;
                }
                break; // first hit wins -- no need to look at r's other columns
            }
        }
    }
}

task compute() void {
    if (is_iterative) {
        record_ts(ts_round, TS_COMPUTE_ENTRY);
    }

    // Reset y_bitmap and y_bitmap_reduced
    @mov32(y_bitmap_dsd, fill_bitmap_u32);
    @mov32(y_bitmap_reduced_dsd, fill_bitmap_u32);

    // Phase 3: dispatch to whichever traversal strategy this round is
    // using -- only the LOCAL computation differs (see the plan); the
    // reset above and the reduce below are shared, unmodified either way.
    if (is_bottom_up) {
        compute_bottomup();
    } else {
        compute_topdown();
    }

    if (is_iterative) {
        record_ts(ts_round, TS_REDUCE_ISSUE);
    }

    // Phase 4: OR-reduce this row's local contributions toward its
    // diagonal -- reduce_or operates directly on y_bitmap's packed words,
    // no dense expansion needed (see y_bitmap_reduced's own comment).
    mpi_x.reduce_or(prow_id, &y_bitmap, &y_bitmap_reduced, BITMAP_WORDS, reduce_done_task_id);
}

task reduce_done() void {
    if (!is_iterative) {
        // Single SpMV End: all PEs exit
        sys_mod.unblock_cmd_stream();
        return;
    }

    record_ts(ts_round, TS_REDUCE_DONE);

    // Phase 5: local termination condition (output mask)
    if (pcol_id == prow_id) {
        //
        // Runs on EVERY round, including the last: if this only ran when
        // there's a next round to feed (like an unconditional copy would),
        // the final round's discoveries would never make it into
        // visited_bitmap, and x_bitmap would end the call holding stale data
        // from the second-to-last round instead of this round's actual
        // new nodes.
        //
        // Word-level, not bit-level: newly_word's zero bits are exactly the
        // rows that are either not hit this round or already visited, so a
        // single AND-NOT per word replaces a per-row bit test. Padding-bit
        // invariant holds automatically -- y_bitmap_reduced's padding is
        // always 0, so newly_word's padding is always 0 too (AND with
        // anything), and visited_bitmap/x_bitmap's padding stays 0
        // inductively (OR/assign of an always-0 value).
        var w: u16 = 0;
        while (w < BITMAP_WORDS) : (w += 1) {
            const newly_word: u32 = y_bitmap_reduced[w] & ~visited_bitmap[w];
            visited_bitmap[w] |= newly_word;
            x_bitmap[w] = newly_word;
        }

        // nz_local: popcount of x_bitmap, which the loop above just set to
        // exactly this round's newly-discovered bits -- no separate storage
        // needed. reduce_fadds (below, via term_col_done()) still just sums
        // whatever's here, so nz_total ends up exactly Beamer's nf (next
        // round's frontier size) instead of a 0/1 flag, at zero added
        // communication cost. Termination is unchanged: nf == 0 means
        // nothing new was found, same as the old flag's 0.0 case.
        @popcnt(popcnt_dst_dsd, popcnt_src_dsd);
        nz_local[0] = 0.0;
        var pw: u16 = 0;
        while (pw < 2 * BITMAP_WORDS) : (pw += 1) {
            nz_local[0] += @as(f32, popcnt_scratch[pw]);
        }
    }

    rounds_completed[0] += 1;
    record_ts(ts_round, TS_RELAY_ISSUE);

    // Phase 6: start termination check relay -- broadcast (not reduce)
    // rooted at pcol_id (this column's own diagonal PE), not MID: only the
    // diagonal ever has a real nz_local, so there's nothing to actually sum,
    // just a value to move. Functionally equivalent to the old
    // reduce_fadds(MID, ...) (every row ends up with the same value either
    // way) but considerably cheaper -- reduce_fadds is the only
    // <collectives_2d> primitive that needs BOTH fabric colors (see its own
    // module comment), and its teardown is a two-stage, every-PE-sends
    // handshake, versus broadcast's single-PE-sends/everyone-else-waits
    // teardown (compare collectives_2d/pe.csl's teardown_reduce_network()
    // and teardown_broadcast_network()).
    mpi_y.broadcast(pcol_id, @ptrcast([*]u32, &nz_local), 1, term_col_done_task_id);
}


// Column-broadcast (phase A, above) is needed from every column: each
// column's diagonal lives at a different row, and every column's own value
// must reach row MID.

// Only row MID does phases B/C for real, every other row skips straight to
// phase D and simply waits there.

// This is safe because mpi_x (phases B/C) and mpi_y (phase D) use separate fabric
// queues/colors, so row MID being mid-FSM in mpi_x doesn't block it from later joining
// mpi_y's phase D, and a non-root broadcast() participant genuinely
// blocks on its own fabric queue waiting for real data -- it doesn't
// require the root to have already called broadcast() first.
task term_col_done() void {
    // column-bcast done: every row now holds this column's shared value in
    // its own nz_local (phase 6's broadcast overwrote it in place)

    if (prow_id == MID) {
        // Phase 7: reduce the local term conditions on the (MID, MID) PE
        mpi_x.reduce_fadds(MID, @ptrcast([*]f32, &nz_local), @ptrcast([*]f32, &nz_total),
                            1, term_row_done_task_id);
    } else {
        // Non-MID PEs skip to Phase 9:
        mpi_y.broadcast(MID, @ptrcast([*]u32, &nz_total), 1, term_col_bcast_done_task_id);
    }
}


task term_row_done() void {
    // row-reduce done: (MID, MID) now holds final termination condition.

    // Phase 8: Flood it back out, row first...
    mpi_x.broadcast(MID, @ptrcast([*]u32, &nz_total), 1, term_row_bcast_done_task_id);
}

task term_row_bcast_done() void {
    // row-bcast done: al PEs on MID row hold the termination condition

    // Phase 9: bcast term condition on every col (non-MID PEs are already waiting)
    mpi_y.broadcast(MID, @ptrcast([*]u32, &nz_total), 1, term_col_bcast_done_task_id);
}

task term_col_bcast_done() void {

    record_ts(ts_round, TS_TERM_COL_BCAST_DONE);
    // Unconditional (not max_rounds-gated), overwritten every round -- see
    // round_trip_done_buffer's own declaration comment. Whichever round
    // this task last runs in (i.e. the true final round, whatever its
    // index), this buffer ends up holding that round's timestamp.
    timestamp.get_timestamp(&round_trip_done_buffer);
    // col-bcast done: every PE now holds the termination condition

    // Phase D telemetry: nf_history[ts_round] is round ts_round's OWN
    // discovery count (this is still the OLD ts_round -- the round that
    // just finished -- direction_history's own update below happens after
    // ts_round is advanced, since that one instead records the NEXT
    // round's direction).
    if (ts_round < max_rounds) {
        nf_history[ts_round] = @as(u32, nz_total[0]);
    }

    // Check term condition
    if (nz_total[0] != 0.0) {

        // Direction decision: nz_total is now Beamer's nf (next round's
        // frontier size, see reduce_done()), already flooded to every PE by
        // the col-bcast above -- so every PE reaches this same comparison
        // on the same value and switches in lockstep, with no extra
        // agreement step needed. One-way only, by design (see is_bottom_up's
        // own comment): switching back is deliberately unsupported, which
        // is what lets Phase B build the transposed structure in place
        // instead of duplicating it.
        if (!is_bottom_up and nz_total[0] > @as(f32, tau_switch_count)) {
            is_bottom_up = true;
            is_bottom_up_dbg[0] = 1;
            // Synchronous, runs to completion before the broadcast below
            // (into next round's compute()) is issued -- compute_bottomup()
            // (Phase C) can then safely assume the transposed structure is
            // already in place by the time it's dispatched to.
            timestamp.get_timestamp(&transpose_tic_buffer);
            transpose_structure();
            timestamp.get_timestamp(&transpose_toc_buffer);
        }

        // rounds_completed[0] was already incremented (in reduce_done())
        ts_round = rounds_completed[0];
        if (ts_round < max_rounds) {
            if (is_bottom_up) {
                direction_history[ts_round] = 1;
            } else {
                direction_history[ts_round] = 0;
            }
        }
        record_ts(ts_round, TS_VBCAST_ISSUE);

        // Start with Phase 1 again: row-bcast updated visited bitmap
        mpi_x.broadcast(prow_id, &visited_bitmap, BITMAP_WORDS, visited_bcast_done_task_id);

    } else {
        // BFS has converged. One-time, end-of-run parent resolution (Phase B
        // of the on-device parent resolution plan): resolve each row's P
        // per-PE candidates down to a single winner at PE-column 0, instead
        // of leaving that combine to the host after a full P-wide transfer
        // (see parent_local_buf's own declaration comment). Runs exactly
        // once per f_spmv_iter call, never mid-round -- safe to reuse mpi_x's
        // colors/queues/DSRs here since all other mpi_x traffic for this run
        // has already fully torn down by the time termination is reached.
        if (is_iterative) {
            timestamp.get_timestamp(&parent_resolve_tic_buffer);
            mpi_x.reduce_select_any(0, &parent_local_buf, &parent_relay_result,
                                     PARENT_NONE, blk, parent_resolve_done_task_id);
        } else {
            sys_mod.unblock_cmd_stream();
        }
    }
}

task parent_resolve_done() void {
    timestamp.get_timestamp(&parent_resolve_toc_buffer);
    sys_mod.unblock_cmd_stream();
}

comptime {
    @bind_local_task(compute, compute_task_id);
    @bind_local_task(reduce_done, reduce_done_task_id);
    @bind_local_task(term_col_done, term_col_done_task_id);
    @bind_local_task(term_row_done, term_row_done_task_id);
    @bind_local_task(term_row_bcast_done, term_row_bcast_done_task_id);
    @bind_local_task(term_col_bcast_done, term_col_bcast_done_task_id);
    @bind_local_task(visited_bcast_done, visited_bcast_done_task_id);
    @bind_local_task(parent_resolve_done, parent_resolve_done_task_id);

    @export_symbol(ptr_x_bitmap, "x_bitmap");
    @export_symbol(ptr_y_bitmap_reduced, "y_bitmap_reduced");
    @export_symbol(ptr_visited_bitmap, "visited_bitmap");
    @export_symbol(ptr_rounds_completed, "rounds_completed");
    // Exported name stays "parent_local_buf" (host-side callers' runner.get_id
    // lookups are unchanged) but now points at parent_relay_result -- the
    // POST-REDUCE buffer, meaningful only at PE-column 0 -- instead of each
    // PE's own raw candidate. See parent_relay_result's own declaration comment.
    @export_symbol(ptr_parent_relay_result, "parent_local_buf");
    @export_symbol(ptr_mat_rows_buf, "mat_rows_buf");
    @export_symbol(ptr_mat_col_idx_buf, "mat_col_idx_buf");
    @export_symbol(ptr_mat_col_loc_buf, "mat_col_loc_buf");
    @export_symbol(ptr_mat_col_len_buf, "mat_col_len_buf");
    @export_symbol(ptr_local_nnz, "local_nnz");
    @export_symbol(ptr_local_nnz_cols, "local_nnz_cols");
    @export_symbol(ptr_local_nnz_rows, "local_nnz_rows");
    @export_symbol(ptr_mat_row_idx_buf, "mat_row_idx_buf");
    @export_symbol(ptr_mat_row_loc_buf, "mat_row_loc_buf");
    @export_symbol(ptr_mat_row_len_buf, "mat_row_len_buf");
    @export_symbol(ptr_nz_total, "nz_total");
    @export_symbol(ptr_is_bottom_up_dbg, "is_bottom_up_dbg");
    @export_symbol(ptr_tsc_start_buffer, "tsc_start_buffer");
    @export_symbol(ptr_tsc_end_buffer, "tsc_end_buffer");
    @export_symbol(ptr_transpose_tic_buffer, "transpose_tic_buffer");
    @export_symbol(ptr_transpose_toc_buffer, "transpose_toc_buffer");
    @export_symbol(ptr_round_trip_start_buffer, "round_trip_start_buffer");
    @export_symbol(ptr_round_trip_done_buffer, "round_trip_done_buffer");
    @export_symbol(ptr_parent_resolve_tic_buffer, "parent_resolve_tic_buffer");
    @export_symbol(ptr_parent_resolve_toc_buffer, "parent_resolve_toc_buffer");
    @export_symbol(ptr_ts_buf, "ts_buf");
    @export_symbol(ptr_nf_history, "nf_history");
    @export_symbol(ptr_direction_history, "direction_history");

    @export_symbol(f_spmv);
    @export_symbol(f_spmv_iter);
    @export_symbol(f_enable_tsc);
    @export_symbol(f_tic);
    @export_symbol(f_toc);
}
