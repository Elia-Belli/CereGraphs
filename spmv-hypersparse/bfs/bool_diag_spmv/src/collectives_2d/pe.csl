// For an overview of the code in this file, please see `README_collectives_2d.rst`

param dim_params;

// Default value: X uses 2 and 4, Y uses 3 and 5
// input queue and output queue have the same ID
param queues = [2]u16{dim_params.DIM_ID + 2, dim_params.DIM_ID + 4};

// Explicit DSR allocation
// Default value: X uses DSR's set 1, Y uses DSR's set 2
param dest_dsr_ids = [1]u16{dim_params.DIM_ID+1};
param src0_dsr_ids = [1]u16{dim_params.DIM_ID+1};
param src1_dsr_ids = [1]u16{dim_params.DIM_ID+1};

const dest_dsr = @get_dsr(dsr_dest, dest_dsr_ids[0]);
const src0_dsr = @get_dsr(dsr_src0, src0_dsr_ids[0]);
const src1_dsr = @get_dsr(dsr_src1, src1_dsr_ids[0]);

const layout_module = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
// local repo copy (see bool_diag_spmv/README or GRAPH500_BENCHMARK.md for
// why this is vendored in-tree instead of importing the container's
// <collectives_2d>: stage 2 of the bitmap work adds an OR-reduce here,
// experimented on freely without touching the system-wide stdlib copy).
// NOTE: CSL resolves relative @import_module paths relative to the
// top-level compiled file's directory (bool_diag_spmv/src/, where
// layout_bool.csl lives), not relative to this file's own directory --
// confirmed empirically (a plain "./ctrl_wavelet.csl" here failed to
// resolve) -- so this path is written relative to src/, not to
// src/collectives_2d/ where this file itself lives.
const ctrl = @import_module("./collectives_2d/ctrl_wavelet.csl");
const color_config = tile_config.color_config;
const switch_config = tile_config.switch_config;

// The directions for a given dimension:
// for EAST/WEST, EAST is "positive" -> x-indices increase as we go EAST
// for NORTH/SOUTH, SOUTH is "positive" -> y-indices increase as we go SOUTH
const POS_DIR = dim_params.POS_DIR;
const NEG_DIR = dim_params.NEG_DIR;

const DATA_COLOR_0 = dim_params.ids.DATA_COLOR_0;
const DATA_COLOR_1 = dim_params.ids.DATA_COLOR_1;
const ACTIVATE_FSM_TASK_ID = dim_params.ids.ACTIVATE_FSM_TASK_ID;
const NUM_PES = dim_params.NUM_PES;

// The entrypoint LOCK is picked up by HW scheduler only if
// teardown is received and the operation is done.
// where the teardown handler T29 activates LOCK and
// the operation blocks LOCK in the beginning and unblocks it when it finishes.
const C_LOCK: local_task_id = @get_local_task_id(@get_int(dim_params.ids.C_LOCK));

const color_0_mask: u32 = (1 << @get_int(DATA_COLOR_0));
const color_1_mask: u32 = (1 << @get_int(DATA_COLOR_1));

// This is the only place in the code where we track whether the
// current instantiation of this module is in the x-dimension or the
// y-dimension. This is used in selecting queues and picking whether
// `pe_id` is the result of `get_x_coord()` or `get_y_coord()`
const DIM_ID = dim_params.DIM_ID;

// Our pe_id is either an x-index or a y-index depending on whether this
// current module instantiation is in the x-dimension or the y-dimension
// Importantly: this value is set at runtime instead of compile-time to
// minimimze the number of ELF files generated.
var pe_id: u16;

// These get properly initialized at runtime in the `init()` function.
var reduce_color_neg: color;
var reduce_color_pos: color;

const COLOR_0_Q = queues[0];
const COLOR_1_Q = queues[1];

// Get input queue handles based on IDs
const COLOR_0_IQ = @get_input_queue(COLOR_0_Q); // X uses 2, Y uses 3
const COLOR_1_IQ = @get_input_queue(COLOR_1_Q); // X uses 4, Y uses 5

const task_id_COLOR_0 = if (@is_arch("wse3")) @get_data_task_id(COLOR_0_IQ) else @get_data_task_id(DATA_COLOR_0);
const task_id_COLOR_1 = if (@is_arch("wse3")) @get_data_task_id(COLOR_1_IQ) else @get_data_task_id(DATA_COLOR_1);

// Get output queue handles based on IDs
const COLOR_0_OQ = @get_output_queue(COLOR_0_Q); // X uses 2, Y uses 3
const COLOR_1_OQ = @get_output_queue(COLOR_1_Q); // X uses 4, Y uses 5

const data_0_fabin = @get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = COLOR_0_IQ });
const data_1_fabin = @get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = COLOR_1_IQ });
const data_0_fabout = @get_dsd(fabout_dsd,
                               if (@is_arch("wse3")) .{ .extent = 1, .output_queue = COLOR_0_OQ }
                               else .{ .fabric_color = DATA_COLOR_0, .extent = 1, .output_queue = COLOR_0_OQ });
const data_1_fabout = @get_dsd(fabout_dsd,
                               if (@is_arch("wse3")) .{ .extent = 1, .output_queue = COLOR_1_OQ }
                               else .{ .fabric_color = DATA_COLOR_1, .extent = 1, .output_queue = COLOR_1_OQ });

var reduce_neg_fabin: fabin_dsd;
var reduce_pos_fabin: fabin_dsd;
var reduce_neg_fabout: fabout_dsd;
var reduce_pos_fabout: fabout_dsd;

const reduce_fabins = [2]fabin_dsd { data_0_fabin, data_1_fabin };
const reduce_fabouts = [2]fabout_dsd { data_0_fabout, data_1_fabout };

// Struct that describes a current network configuration
// reduce_or: bitwise OR-reduce, added for bool_diag_spmv's bitmap work --
// see reduce_or()/transfer_data_reduce_or() below. Mirrors reduce_fadds's
// FSM/DSR/teardown machinery exactly (none of that is arithmetic-specific);
// only the actual combine op differs (@or16 instead of @fadds), which is
// why it needs its own Ftype tag, not a variant of reduce_fadds.
// reduce_select_any: "keep mine if valid, else take incoming" reduce, added
// for bool_diag_spmv's on-device parent resolution work -- unlike
// reduce_fadds/reduce_or, there is no fused ALU op for this (no @max16/
// @select16/@cmp16 builtin exists -- confirmed by direct compiler probing),
// so its per-hop combine is ordinary branching CSL compute, not a single
// fused async instruction. See reduce_select_any()/transfer_data_reduce_select_any()
// below.
const Ftype = enum(u16) { broadcast, scatter, gather, reduce_fadds, reduce_or, reduce_select_any };
const Network_Config = struct {
  root: u16,
  count: u16,
  type: Ftype,
  // Only meaningful for reduce_select_any -- the sentinel value marking
  // "no candidate" in send_buf/recv_buf. Unused (always 0) by every other
  // op; CSL struct literals have no field-default syntax (confirmed by
  // direct compiler probing), so every Network_Config literal below must
  // set this explicitly even when irrelevant.
  sentinel: u32
};

// This array is used as a placeholder value for `mem1d_dsd`s. DSDs require
// tensor_access to point to a valid piece of memory, so we use this
var invalid_u32 = @zeros([1]u32);
// Same, but u16-typed -- reduce_or operates on 16-bit elements (CSL has no
// @or32; @or16/@and16/@xor16 are 16-bit only), so its own mem1d_dsd needs a
// u16 base address, not invalid_u32's u32 one. See transfer_data_reduce_or().
var invalid_u16 = @zeros([1]u16);

// The state of our finite state machine. This type just groups together
// global state so that it is in a single place that is easier to keep
// track of
const StateEnum = enum(u16) { Configure_network, Transfer_Data, Callback };
const FSM_State = struct {
  send_buf: [*]u32,
  recv_buf: [*]u32,
  state: StateEnum,
  callback: local_task_id,
  counter: u16
};

// The initial network config is a broadcast network rooted at 0
var cur_network_cfg = Network_Config {
  .root = 0,
  .count = 0,
  .type = Ftype.broadcast,
  .sentinel = 0
};


// The FSM state is initially invalid
var fsm_state = FSM_State {
  .send_buf = &invalid_u32,
  .recv_buf = &invalid_u32,
  .state = StateEnum.Configure_network,
  // SDR requires the entrypoint starts from 8.
  // this initialization is don't care because it is overwritten by
  // broadcast(), gather(), scatter() and reduce().
  .callback = @get_local_task_id(8),
  .counter = 0
};

// Memory and associated DSDs for sending control wavelets
var ctrl_buf = @zeros([1]u32);
const ctrl_mem = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> ctrl_buf[i] });
const ctrl_out = @get_dsd(fabout_dsd,
                          if (@is_arch("wse3")) .{ .extent = 1, .control = true, .output_queue = COLOR_0_OQ }
                          else .{ .extent = 1, .fabric_color = DATA_COLOR_0, .control = true, .output_queue = COLOR_0_OQ });
const color1_ctrl_out = @get_dsd(fabout_dsd,
                                 if (@is_arch("wse3")) .{ .extent = 1, .control = true, .output_queue = COLOR_1_OQ }
                                 else .{ .extent = 1, .fabric_color = DATA_COLOR_1, .control = true, .output_queue = COLOR_1_OQ });

// Track whether `init()` has been called for this module
var lib_initialized: bool = false;

// Before the user can use any `collectives_2d` functions, they must call `init()`
fn init() void {

  var coords = [2]u16 { layout_module.get_x_coord(), layout_module.get_y_coord() };
  // Select which coordinate we will be using as our id for this module instantiation
  // The other coordinate will *never* be used (we pretend it doesn't exist!)
  pe_id = coords[DIM_ID];

  const reduce_colors = [2]color { DATA_COLOR_0, DATA_COLOR_1 };
  reduce_color_neg = reduce_colors[pe_id % 2];
  reduce_color_pos = reduce_colors[(pe_id + 1) % 2];

  reduce_neg_fabin = reduce_fabins[pe_id % 2];
  reduce_pos_fabin = reduce_fabins[(pe_id + 1) % 2];

  reduce_neg_fabout = reduce_fabouts[pe_id % 2];
  reduce_pos_fabout = reduce_fabouts[(pe_id + 1) % 2];

  lib_initialized = true;
}


fn start_data_transfer() void {
    // We are fully done reconfiguring.
    // Because we have already reconfigured, the cur_network_state should
    // reflect this reality

    // We are now ready to activate `fsm()` and begin transfering data
    fsm_state.counter = 0;
    fsm_state.state = StateEnum.Transfer_Data;
    @activate(ACTIVATE_FSM_TASK_ID);
}


// User facing `broadcast` function
fn broadcast(root: u16, buf: [*]u32, count: u16, callback: local_task_id) void {

  // WARNING: block LOCK in the beginning and only
  // unblock LOCK when the operation finishes
  @block(C_LOCK);

  @assert(lib_initialized);
  // Request a broadcast network rooted at `root`
  cur_network_cfg = Network_Config {
    .root = root,
    .count = count,
    .type = Ftype.broadcast,
    .sentinel = 0
  };
  // Initialize the FSM state to store `buf` and `callback`
  fsm_state = FSM_State {
    .send_buf = buf,
    .recv_buf = buf,
    .state = StateEnum.Configure_network,
    .callback = callback,
    .counter = 0
  };
  // all ops must clear filter and switch first
  clear_filter_and_switch();
  // reconfigure the routing on C0 and start the FSM
  configure_broadcast_network();
  start_data_transfer();
}

fn scatter(root: u16, send_buf: [*]u32, recv_buf: [*]u32, count: u16, callback: local_task_id) void {

  // WARNING: block LOCK in the beginning and only
  // unblock LOCK when the operation finishes
  @block(C_LOCK);

  @assert(lib_initialized);
  // Request a scatter network rooted at `root`
  cur_network_cfg = Network_Config {
    .root = root,
    .count = count,
    .type = Ftype.scatter,
    .sentinel = 0
  };
  // Initialize the FSM state to store `send_buf`, `recv_buf`, and `callback`
  fsm_state = FSM_State {
    .send_buf = send_buf,
    .recv_buf = recv_buf,
    .state = StateEnum.Configure_network,
    .callback = callback,
    .counter = 0
  };
  // all ops must clear filter and switch first
  clear_filter_and_switch();
  // reconfigure the routing and filter on C0 and start the FSM
  configure_scatter_network();
  start_data_transfer();
}

fn gather(root: u16, send_buf: [*]u32, recv_buf: [*]u32, count: u16, callback: local_task_id) void {

  // WARNING: block LOCK in the beginning and only
  // unblock LOCK when the operation finishes
  @block(C_LOCK);

  @assert(lib_initialized);
  // Request a gather network rooted at `root`
  cur_network_cfg = Network_Config {
    .root = root,
    .count = count,
    .type = Ftype.gather,
    .sentinel = 0
  };
  // Initialize the FSM state to store `send_buf`, `recv_buf`, and `callback`
  fsm_state = FSM_State {
    .send_buf = send_buf,
    .recv_buf = recv_buf,
    .state = StateEnum.Configure_network,
    .callback = callback,
    .counter = 0
  };
  // all ops must clear filter and switch first
  clear_filter_and_switch();
  // reconfigure the routing and switch on C0 and start the FSM
  configure_gather_network();
  start_data_transfer();
}

// `fadds` only works on f32 data
fn reduce_fadds(root: u16, send_buf: [*]f32, recv_buf: [*]f32, count: u16, callback: local_task_id) void {

  // WARNING: block LOCK in the beginning and only
  // unblock LOCK when the operation finishes
  @block(C_LOCK);

  @assert(lib_initialized);
  // Request a gather network rooted at `root`
  cur_network_cfg = Network_Config {
    .root = root,
    .count = count,
    .type = Ftype.reduce_fadds,
    .sentinel = 0
  };
  // Initialize the FSM state to store `send_buf`, `recv_buf`, and `callback`
  fsm_state = FSM_State {
    .send_buf = @ptrcast([*]u32, send_buf),
    .recv_buf = @ptrcast([*]u32, recv_buf),
    .state = StateEnum.Configure_network,
    .callback = callback,
    .counter = 0
  };
  // all ops must clear filter and switch first
  clear_filter_and_switch();
  // reconfigure the routing and switch on C0 and C1, then start the FSM
  configure_reduce_network(DATA_COLOR_0);
  configure_reduce_network(DATA_COLOR_1);
  start_data_transfer();
}

// Bitwise OR-reduce -- see the Ftype.reduce_or comment above for why this
// is a separate function rather than a reduce_fadds variant. `count` keeps
// the same meaning reduce_fadds/broadcast already give it (number of u32
// words) -- the caller never needs to think in 16-bit halves; that
// doubling happens only inside transfer_data_reduce_or().
fn reduce_or(root: u16, send_buf: [*]u32, recv_buf: [*]u32, count: u16, callback: local_task_id) void {

  // WARNING: block LOCK in the beginning and only
  // unblock LOCK when the operation finishes
  @block(C_LOCK);

  @assert(lib_initialized);
  cur_network_cfg = Network_Config {
    .root = root,
    .count = count,
    .type = Ftype.reduce_or,
    .sentinel = 0
  };
  // send_buf/recv_buf are already u32 -- no @ptrcast needed (unlike
  // reduce_fadds, which takes f32 and casts at this same boundary).
  fsm_state = FSM_State {
    .send_buf = send_buf,
    .recv_buf = recv_buf,
    .state = StateEnum.Configure_network,
    .callback = callback,
    .counter = 0
  };
  // all ops must clear filter and switch first
  clear_filter_and_switch();
  // reconfigure the routing and switch on C0 and C1, then start the FSM --
  // configure_reduce_network() is pure routing/color config, no arithmetic
  // dependence, reused unchanged from reduce_fadds.
  configure_reduce_network(DATA_COLOR_0);
  configure_reduce_network(DATA_COLOR_1);
  start_data_transfer();
}

// "Keep mine if valid, else take incoming" combine -- the correctness
// property that distinguishes this from reduce_or: the result is
// non-sentinel iff AT LEAST ONE input was non-sentinel, and whenever
// non-sentinel it is ALWAYS exactly one of the genuinely-supplied values,
// never a corrupted bitwise mix the way OR(3,5)=7 would be. Ordinary CSL
// compute, not a fused fabric-transit ALU op (no @max16/@select16/@cmp16
// builtin exists -- confirmed by direct compiler probing), so dst/incoming/
// mine are plain [*]u32 slices, not DSDs -- this never touches the fabric
// itself, only already-landed local memory.
fn select_merge_u32(dst: [*]u32, incoming: [*]u32, mine: [*]u32, count: u16, sentinel: u32) void {
  var i: u16 = 0;
  while (i < count) : (i += 1) {
    dst[i] = if (incoming[i] != sentinel) incoming[i] else mine[i];
  }
}

// Select-any reduce: like reduce_or, but for values where a genuine
// per-position pick (not a bitwise combine) is required -- see
// select_merge_u32's own comment for why reduce_or's fused @or16 approach
// silently corrupts this case. `sentinel` marks "no candidate" in
// send_buf/recv_buf. Only 2 buffers needed, same as reduce_or/reduce_fadds
// -- NOT 3, despite each hop here being a real receive-then-branch-then-
// forward sequence instead of one fused async op. The trick (see
// transfer_data_reduce_select_any()'s own comment): a middle root merges
// its own value into recv_buf IMMEDIATELY after its first incoming side
// lands, rather than saving that merge for last -- which frees send_buf's
// memory (its value has already been consumed) to reuse AS the landing
// zone for the second incoming side, instead of needing a dedicated third
// buffer. Every non-root PE's recv_buf is otherwise entirely unused (only
// the root's is ever read by the caller), so it doubles as that PE's own
// landing zone too. send_buf/recv_buf must not alias each other (same
// non-aliasing requirement bool_diag_spmv's own y_bitmap/y_bitmap_reduced
// already documents for reduce_or's send/recv pair).
fn reduce_select_any(root: u16, send_buf: [*]u32, recv_buf: [*]u32,
                      sentinel: u32, count: u16, callback: local_task_id) void {

  // WARNING: block LOCK in the beginning and only
  // unblock LOCK when the operation finishes
  @block(C_LOCK);

  @assert(lib_initialized);
  cur_network_cfg = Network_Config {
    .root = root,
    .count = count,
    .type = Ftype.reduce_select_any,
    .sentinel = sentinel
  };
  fsm_state = FSM_State {
    .send_buf = send_buf,
    .recv_buf = recv_buf,
    .state = StateEnum.Configure_network,
    .callback = callback,
    .counter = 0
  };
  // all ops must clear filter and switch first
  clear_filter_and_switch();
  // reconfigure the routing and switch on C0 and C1, then start the FSM --
  // configure_reduce_network() is pure routing/color config, no arithmetic
  // dependence, reused unchanged from reduce_fadds/reduce_or.
  configure_reduce_network(DATA_COLOR_0);
  configure_reduce_network(DATA_COLOR_1);
  start_data_transfer();
}


// initiate_teardowns() is called when the operation {broadcast, gather, scatter,
// reduce_adds} finishes the data transfer.
// The root should send out teardown wavelets to all others PEs to turn C0 and C1
// back to teardown mode.
fn initiate_teardowns() void {
  switch (cur_network_cfg.type) {
    Ftype.broadcast => {
      teardown_broadcast_network();
    },
    Ftype.scatter => {
      teardown_scatter_network();
    },
    Ftype.gather => {
      teardown_gather_network();
    },
    Ftype.reduce_fadds => {
      teardown_reduce_network();
    },
    Ftype.reduce_or => {
      // same teardown as reduce_fadds -- pure control-wavelet/color
      // bookkeeping, no arithmetic dependence.
      teardown_reduce_network();
    },
    Ftype.reduce_select_any => {
      // same teardown as reduce_fadds/reduce_or -- pure control-wavelet/
      // color bookkeeping, no dependence on the per-hop combine mechanics.
      teardown_reduce_network();
    }
  }
}

// Broadcast-network specific teardown initiation
fn teardown_broadcast_network() void {
  // Only the `cur_network_cfg.root` PE needs to send out a teardown wavelet
  // This is because it is the *only* PE which can send a teardown wavelet
  // to all other PEs on `DATA_COLOR_0` (all other PEs in this network config
  // are set up to *receive* on `DATA_COLOR_0`), not send!
  if (pe_id == cur_network_cfg.root) {
    ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown } });
    mem_to_fabout_no_activate(ctrl_out, ctrl_mem);
  }
  // Other PEs do not have to do anything! Just wait for the teardown wavelet
  // sent out by `cur_network_cfg.root`
}

// Scatter-network specific teardown initiation
fn teardown_scatter_network() void {
  // Only the `cur_network_cfg.root` PE needs to send out a teardown wavelet
  // The same logic as `broadcast` applies here: `scatter` is another
  // `root` -> all other PE operation
  if (pe_id == cur_network_cfg.root) {
    ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown } });
    mem_to_fabout_no_activate(ctrl_out, ctrl_mem);
  }
}

// Gather-network specific teardown initiation
// In gather-networks, the PEs on either end (pe_0, pe_max) are responsible
// for sending teardown wavelets towards PEs in the middle.
//
// After transfer_data_gather(), the routing is
//                root
// -->  --> -->    <--   <-- <--     <--
// ^               |                    ^
// |               v                    |
// pos0   pos1     pos1   pos1        pos0
//
// Both P0 and Pw-1 send TD.
// The TD from Pw-1 resets the switch position of root because PE root+1
// pops cmd0. The routing becomes
//                root
// -->  --> -->  -->     <-- <--     <--
// ^               |                    ^
// |               v                    |
// pos0   pos1     pos0    teardown  teardown
//
// Then the TD from P0 can reach the root because the pos0 has rx = WEST.
// The routing becomes
//                      root
// -->       --> -->   -->       <-- <--     <--
// ^                     |                     ^
// |                     v                     |
// teardown  teardown  teardown  teardown   teardown
//
fn teardown_gather_network() void {

  const cur_root = cur_network_cfg.root;

  if (pe_id == 0) {

    // If we're PE0 and we're the root, we must wait for teardowns from
    // the other end of our row or columns. DATA_COLOR_0 has tx = RAMP in this
    // case, and we cannot send out any teardowns
    if (cur_root == 0) {
      return;
    }
    // Otherwise, send a teardown wavelet to POS_DIR (EAST or SOUTH)
    ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown } });
    mem_to_fabout_no_activate(ctrl_out, ctrl_mem);

  } else if (pe_id == NUM_PES - 1) {

    // Analogous logic to `(pe_id == 0) and (cur_root == 0)` above
    if (cur_root == NUM_PES - 1) {
      return;
    }
    if (cur_root != 0) {
      // In cases where we are the last PE and the current root is somewhere
      // in the middle of our row or column, we tear down every whose pe_id is
      // greater than the root, then rely on the "guard PE" (root + 1) to
      // pop `cmd0` and let `cmd1` flip the root PE's switch. This then allows
      // the root PE to be torn down by the teardown wavelet from PE0.
      ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown },
                                            .cmd1 = .{ .no_ce = true, .type = ctrl.Cmd.Reset }});
    } else {
      // On the other hand, if we are the last PE and the current root is PE0,
      // PE0 does not have a switch. This is because there are no PEs with
      // pe_id < 0, and therefore, no-one to send it wavelets from NEG_DIR.
      // So, in this case, we (the last PE) are responsible for tearing down
      // the root as well as all other PEs.
      ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown },
                                             .cmd1 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown }});
    }
    mem_to_fabout_no_activate(ctrl_out, ctrl_mem);
  }
}

// The extreme PEs (pid=0 and pid=w-1) send out 2 TDs, one for C0 and the other for C1.
// Each "send" uses a different output queue but the SAME DSR.
// To avoid the collision on the same DSR, we need to send both TDs sequentially.
// "td_reduce_state" is used to serialize both TDs.
// - td_reduce_state = 0
//   the extreme PEs send a TD on the color with R->R
// - td_reduce_state = 1
//   all PEs except the root send a TD to either positive direction or negative direction
//
// td_reduce_state is a sub-state under StateEnum.Callback.
// The sequence is
// - StateEnum.Callback, td_reduce_state = 0 --> activate ACTIVATE_FSM_TASK_ID
// - StateEnum.Callback, td_reduce_state = 1 --> end the operation
//
var td_reduce_state : u16 = 0;

// The alternating color of reduce network
//
// Suppose NUM_PES = 5 (P0, P1, P2, P3, P4), the following is the
// alternating color assignment. Each PE has negative direction (
// neg) and positive direction (pos). The neg of P0 is C0 and the
// pos of last PE could be C0 or C1.
// If NUM_PES is even, then pos is C0
// If NUM_PES is odd, then pos is C1
//
//  C0  +----+  C1  +----+  C0  +----+  C1  +----+  C0  +----+  C1
// ---- | P0 | ---- | P1 | ---- | P2 | ---- | P3 | ---- | P4 | ----
//      +----+      +----+      +----+      +----+      +----+
//
// The PE sends out a TD to reset the color for itself and the direct
// neighbor.
// The exceptions are neg of P0 and pos of last PE because both only
// have R --> R, so TD only affects itself.
fn teardown_reduce_network() void {

  const cur_root = cur_network_cfg.root;

  ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Teardown } });

  if (0 == td_reduce_state){
    // td_reduce_state = 0
    // - the extreme PEs send a TD on the color with R->R
    //   the DSD operation actives ACTIVATE_FSM_TASK_ID after TD is sent out
    // - other PEs activate ACTIVATE_FSM_TASK_ID directly
    if (pe_id == 0) {
      // (3) pid = 0 sends TD on neg direction (C0) --> receives TD on neg direction
      // PE0 sends out a teardown on DATA_COLOR_0 (which is in RAMP -> RAMP on this PE)
      mem_to_fabout(ctrl_out, ctrl_mem);
    }else if (pe_id == NUM_PES - 1) {
      // (4) last PE sends TD on pos direction --> receive TD on pos direction
      // The last PE sends out a teardown on whatever color it has stored in RAMP -> RAMP,
      if (NUM_PES % 2 == 0) {
        mem_to_fabout(ctrl_out, ctrl_mem);
      } else {
        mem_to_fabout(color1_ctrl_out, ctrl_mem);
      }
    }else{
      // other PEs, 0 < pid < w, activate ACTIVATE_FSM_TASK_ID directly
      @activate(ACTIVATE_FSM_TASK_ID);
    }
    // goto next state
    td_reduce_state += 1;
  }else{
    // td_reduce_state = 1
    // - all PEs except the root send a TD to either positive direction or negative direction.
    //   the DSD operation does not activate ACTIVATE_FSM_TASK_ID after TD is sent out
    //   because the operation is done.

    // (1) 0 <= pid < root sends TD on pos direction --> also receives TD on pos direction
    //     0 < pid <= root receives TD from neg direction
    // NOTE: if root = 0, skip this part
    if ((0 <= pe_id) and (pe_id < cur_root) ){
      if (reduce_color_pos == DATA_COLOR_0){
        mem_to_fabout_no_activate(ctrl_out, ctrl_mem);
      }else{
        mem_to_fabout_no_activate(color1_ctrl_out, ctrl_mem);
      }
    }

    // (2) root < pid < w sends TD on neg direction -->  also receives TD on neg direction
    // root <= pid < w-1 receives TD from pos direction
    // NOTE: if root = w-1, skip this part
    if ( (cur_root < pe_id) and (pe_id < NUM_PES) ){
      if (reduce_color_neg == DATA_COLOR_0){
        mem_to_fabout_no_activate(ctrl_out, ctrl_mem);
      }else{
        mem_to_fabout_no_activate(color1_ctrl_out, ctrl_mem);
      }
    }
    // reset the state
    td_reduce_state = 0;
  }
}

// This function reconfigures the router to a broadcast network rooted at
// cur_network_cfg.root
//
// Routing of the root
//    -->         <-- -->           <--
//    ^              ^                ^
//    |              |                |
// pe_id = 0     0 < pe_id < w-1   pe_id = w-1
// where w = NUM_PES
//
// Routing of non-root
//    <--       <-- <--     --> -->          -->
//    |            |           |               |
//    V            v           v               v
// pe_id = 0   pe_id < root  pe_id > root   pe_id = w-1
fn configure_broadcast_network() void {

  const addr = color_config.get_color_config_addr(DATA_COLOR_0);

  const root = cur_network_cfg.root;

  if (pe_id == root) {
    // we're the root, so rx = RAMP

    // depending on our position in the row, choose the direction to transmit
    if (pe_id == 0) {
      color_config.reset_routes(addr, .{.tx = POS_DIR, .rx = RAMP});
    } else if (pe_id == NUM_PES - 1) {
      color_config.reset_routes(addr, .{.tx = NEG_DIR, .rx = RAMP});
    } else {
      color_config.reset_routes(addr, .{.tx = [2]direction{POS_DIR, NEG_DIR}, .rx = RAMP});
    }
  } else {
    // we're not the root, we are only receiving data

    // depending on our position as well as the position of the root, choose
    // the direction we will receive from
    if (pe_id == 0) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = POS_DIR});
    } else if (pe_id == NUM_PES - 1) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = NEG_DIR});
    } else if (pe_id < root) {
      color_config.reset_routes(addr, .{.tx = [2]direction{RAMP, NEG_DIR}, .rx = POS_DIR});
    } else {
      color_config.reset_routes(addr, .{.tx = [2]direction{RAMP, POS_DIR}, .rx = NEG_DIR});
    }
  }

  // The following two operations are done by clear_filter_and_switch()
  // reset switch position to pos0
  // all PEs have pos0 only, so disable pos1

  // clear teardown-in-progress bit
  // WARNING: if we clear TIP bit before routing is reconfigured, it stalls WSE3 because
  // of "Backpressure on ouptut queue". The UT does send out the data wavelet to the
  // output queue, but output queue cannot push the data to DATA_COLOR_0.
  tile_config.teardown.exit(DATA_COLOR_0);
}

fn clear_filter_and_switch() void {
  const filter_id = @get_filter_id(DATA_COLOR_0);

  // SDR removes the "limits" on the counter filter, instead, we need to set
  // the pass_cnt and drop_cnt. To be compatible with old API which still uses
  // "limits", we need to set pass_cnt (in this case, max_counter) before
  // calling set_max_counter(). Otherwise the drop_cnt may not be set correctly.
  tile_config.filters.set_max_counter(filter_id, 0);
  tile_config.filters.set_active_limit(filter_id, 0);
  tile_config.filters.set_counter(filter_id, 0);

  // WARNING: if we only invalid all switch positions, it generates the wrong
  // result. We have to clear the "current switch position" as well.
  switch_config.clear_current_position(DATA_COLOR_0);
  switch_config.set_invalid_for_all_switch_positions(DATA_COLOR_0);

  // WARNING: gather() sets pop_mode = ALWAYS_POP. If we don't reset pop_mode
  // for subsequent operation, it is going to pop the command from TD (teardown),
  // then TD is no longer a TD.
  switch_config.set_pop_mode(DATA_COLOR_0, tile_config.target.pop_mode.NO_POP);
}

// Set up a filter that scatters data among the NUM_PEs many PEs in chunks
// of `cur_network_cfg.count`
fn configure_scatter_filter() void {
  const chunk_size = cur_network_cfg.count;
  const send_size = NUM_PES * cur_network_cfg.count;

  const init_counter = (send_size - pe_id * chunk_size) % send_size;

  const filter_id = @get_filter_id(DATA_COLOR_0);
  // SDR removes the "limits" on the counter filter, instead, we need to set
  // the pass_cnt and drop_cnt. To be compatible with old API which still uses
  // "limits", we need to set pass_cnt (in this case, max_counter) before
  // calling set_max_counter(). Otherwise the drop_cnt may not be set correctly.
  tile_config.filters.set_max_counter(filter_id, chunk_size - 1);
  tile_config.filters.set_active_limit(filter_id, send_size - 1);
  tile_config.filters.set_counter(filter_id, init_counter);
}

// A scatter network is a broadcast network + a non-trivial filter,
// so we can reuse the code from `configure_broadcast_network`
fn configure_scatter_network() void {
  configure_scatter_filter();
  configure_broadcast_network();
}

// A gather network features all PEs sending data towards the root PE
// All PEs are equipped with switches that are used to sequence data being
// sent towards the root PE.
// If the root PE is not at either extreme of the row or column, it will
// have a central switch, so it can first receive data from NEG_DIR then
// receive data from POS_DIR
//
// root:
//  1st PE     middle                  last PE
//   <--       -->                       -->
//   |           |                         |
//   V           V                         V
//  pos0        pos0                      pos0
//         receive data from neg first
//                <--
//                |
//                V
//              pos1
//
// non-root:
//   -->       -->           <--         <--
//   ^         ^               ^           ^
//   |         |      root     |           |
//  pos0      pos0            pos0        pos0
//
//           -->-->          <--<--
//            pos1            pos1
//  After it sends out the last wavelet, pos0 --> pos1 because of
//  .advance_switch = true
//
fn configure_gather_network() void {

  // (1) configure the routing before the switch position.
  const root = cur_network_cfg.root;

  const addr = color_config.get_color_config_addr(DATA_COLOR_0);

  if (pe_id == root) {

    // We are the root. If we're at either end, the routing is simple:
    // no switches needed.
    if (pe_id == 0) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = POS_DIR});
    } else if (pe_id == NUM_PES - 1) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = NEG_DIR});
    } else {
      // If we're in the middle, then we need a switch to receive first from
      // NEG_DIR, then receive from the POS_DIR
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = NEG_DIR});
    }

  } else if (pe_id == 0) {
    // If PE0 is not the root, then it must just transmit to POS_DIR
    color_config.reset_routes(addr, .{.tx = POS_DIR, .rx = RAMP});

  } else if (pe_id == NUM_PES - 1) {

    // If the last PE is not the root, it must just transmit NEG_DIR
    color_config.reset_routes(addr, .{.tx = NEG_DIR, .rx = RAMP});

  } else if (pe_id < root) {

    // If we are a PE with `pe_id < root`, we transmit to POS_DIR and have a
    // switch that allows us to act as just a NEG_DIR -> POS_DIR conduit
    color_config.reset_routes(addr, .{.tx = POS_DIR, .rx = RAMP});

  } else {
    // If we are a PE with `pe_id > root`, we transmit to NEG_DIR and have a
    // switch that allows us to act as just a POS_DIR -> NEG_DIR conduit
    color_config.reset_routes(addr, .{.tx = NEG_DIR, .rx = RAMP});
  }

  // (2) configure the switch position which needs to inherit configuration
  // from pos0.
  // disable the switch for all PEs
  // the middle PE will reconfigure pos1 later
  switch_config.clear_current_position(DATA_COLOR_0);
  switch_config.set_invalid_for_all_switch_positions(DATA_COLOR_0);

  if (pe_id == root) {

    // We are the root. If we're at either end, the routing is simple:
    // no switches needed, so we skip pid = 0 and pid=w-1.
    if ((pe_id > 0) and (pe_id < NUM_PES - 1)){
      // If we're in the middle, then we need a switch to receive first from
      // NEG_DIR, then receive from the POS_DIR
      switch_config.set_rx_switch_pos1(DATA_COLOR_0, POS_DIR);
      switch_config.set_current_switch_position(DATA_COLOR_0, 0);
    }

  } else if (pe_id == 0) {
    // If PE0 is not the root, then it must just transmit to POS_DIR

  } else if (pe_id == NUM_PES - 1) {

    // If the last PE is not the root, it must just transmit NEG_DIR

  } else if (pe_id < root) {

    // If we are a PE with `pe_id < root`, we transmit to POS_DIR and have a
    // switch that allows us to act as just a NEG_DIR -> POS_DIR conduit
    switch_config.set_rx_switch_pos1(DATA_COLOR_0, NEG_DIR);
    switch_config.set_current_switch_position(DATA_COLOR_0, 0);

  } else {
    // If we are a PE with `pe_id > root`, we transmit to NEG_DIR and have a
    // switch that allows us to act as just a POS_DIR -> NEG_DIR conduit
    switch_config.set_rx_switch_pos1(DATA_COLOR_0, POS_DIR);
    switch_config.set_current_switch_position(DATA_COLOR_0, 0);
  }
  // The PE at `root + 1` is the "guard PE" which pops a command.
  // This is important so that the last PE (pe_id == NUM_PES - 1) can send a
  // command wavelet which tears down all PEs with pe_id > root and then
  // flips the root PE's switch.
  // This, in turn, allows the teardown wavelet sent from NEG_DIR to tear down
  // the root and also find a destination (at the root). Without this mechanism,
  // the NEG_DIR teardown wavelet would remain in the network and block all
  // subsequent operations.
  if (pe_id == root + 1) {
    switch_config.set_pop_mode(DATA_COLOR_0, tile_config.target.pop_mode.ALWAYS_POP);
  }

  // NOTE: we don't need to insert NOP here because switch_config and teardown.exit()
  // work on different config reg, there is no race condition.

  // clear teardown-in-progress bit
  // WARNING: if we clear TIP bit before routing is reconfigured, it stalls broadcast
  // on WSE3. However it seems working on gather.
  // To make it consistent, we always clear TIP after routing/switch is reconfigured.
  tile_config.teardown.exit(DATA_COLOR_0);
}


// Reduce is complicated: it works with 2 colors instead of 1 (alternating colors strategy)
// so, it depends on the td_color as well as the root.
// The end result is an alternating color network, which is a standard CSL idiom
//
//
//  C0  +----+  C1  +----+  C0  +----+  C1  +----+  C0  +----+  C1
// ---- | P0 | ---- | P1 | ---- | P2 | ---- | P3 | ---- | P4 | ----
//      +----+      +----+      +----+      +----+      +----+
//
// 0 < root < w-1
//        +----+           +---+          +----+          +---+           +---+
//    --> | P0 | -->   --> | x | -->  --> |root| <--  <-- | y | <--   <-- |w-1| <--
//        +----+           +---+          +----+          +---+           +---+
//    ^         ^-->   -->     ^ -->   -->     <--    <--      <--     <--    ^
//    | |       |        |     |         |     |         ^     |          ^   | |
//      v                v               v     v         |     v          |     v
//
// root = 0
//        +----+                                          +---+           +---+
//    --> | P0 | -->                                  <-- | y | <--   <-- |w-1| <--
//        +----+                                          +---+           +---+
//    ^         ^-->                                  <--      <--     <--    ^
//    | |       |                                        ^     |          ^   | |
//      v                                                |     v          |     v
//
// root = w-1
//        +----+           +---+                                         +----+
//    --> | P0 | -->   --> | x | -->                                 --> |root| <--
//        +----+           +---+                                         +----+
//    ^         ^-->   -->     ^ -->                                 -->     ^
//    | |       |        |     |                                       |     | |
//      v                v                                             v       v
//
fn configure_reduce_network(td_color: color) void {

  const root = cur_network_cfg.root;

  const addr = color_config.get_color_config_addr(td_color);

  if (td_color == reduce_color_neg) {
    if (pe_id == 0) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = RAMP});
    } else if (pe_id <= root) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = NEG_DIR});
    } else {
      color_config.reset_routes(addr, .{.tx = NEG_DIR, .rx = RAMP});
    }
  } else if (td_color == reduce_color_pos) {
    if (pe_id == NUM_PES - 1) {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = RAMP});
    } else if (pe_id < root) {
      color_config.reset_routes(addr, .{.tx = POS_DIR, .rx = RAMP});
    } else {
      color_config.reset_routes(addr, .{.tx = RAMP, .rx = POS_DIR});
    }
  }

  // clear teardown-in-progress bit
  // WARNING: if we clear TIP bit before routing is reconfigured, it stalls broadcast
  // on WSE3. However it seems working on gather and reduce.
  // To make it consistent, we always clear TIP after routing/switch is reconfigured.
  tile_config.teardown.exit(td_color);
}

// The "library backend" is implemented as a finite state machine due to the
// large amount of async behavior tied togther simply with task activations
task fsm() void {
  switch (fsm_state.state) {
    StateEnum.Transfer_Data => {
      // We're still in the process of transfering data
      transfer_data();
    },
    StateEnum.Callback => {
      // We're done transfering data, time to send out teardown to turn C0/C1
      // back to teardown mode and activate the user-specified callback
      // color
      initiate_teardowns();
      // The operation finishes so we can unblock LOCK.
      // LOCK can be picked only when the TD arrives.
      @unblock(C_LOCK);
    },
    else => {
      @assert(false);
    }
  }
}

var mem = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> invalid_u32[i] });
// u16-typed sibling of `mem`, for reduce_or (CSL's @or16 operates on 16-bit
// elements; `mem`'s element width is tied to invalid_u32's u32 type, so a
// separate placeholder avoids assuming @set_dsd_base_addr can silently
// retarget element width). See transfer_data_reduce_or().
var mem16 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> invalid_u16[i] });
var fabout = @get_dsd(fabout_dsd,
                      if (@is_arch("wse3")) .{ .extent = 1, .output_queue = COLOR_0_OQ }
                      else .{ .extent = 1, .fabric_color = DATA_COLOR_0, .output_queue = COLOR_0_OQ });
var fabin = @get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = COLOR_0_IQ });
var fabout_adv = @get_dsd(fabout_dsd,
                          if (@is_arch("wse3")) .{ .extent = 1, .output_queue = COLOR_0_OQ, .advance_switch = true }
                          else .{ .extent = 1, .fabric_color = DATA_COLOR_0, .output_queue = COLOR_0_OQ, .advance_switch = true });

// For `broadcast`, transfering data is straightforward: the root sends, the others
// receive.
fn transfer_data_broadcast() void {
  if (cur_network_cfg.root == pe_id) {
    fabout = @set_dsd_length(fabout, cur_network_cfg.count);
    mem = @set_dsd_length(mem, cur_network_cfg.count);
    mem = @set_dsd_base_addr(mem, fsm_state.send_buf);

    // NOTE: at the end of this data transfer, we activate ACTIVATE_FSM_TASK_ID
    mem_to_fabout(fabout, mem);
  } else {
    fabin = @set_dsd_length(fabin, cur_network_cfg.count);
    mem = @set_dsd_length(mem, cur_network_cfg.count);
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);

    // NOTE: at the end of this data transfer, we activate ACTIVATE_FSM_TASK_ID
    fabin_to_mem(mem, fabin);
  }

  // when we next run through `fsm()`, we'll be in the `Callback` state ready
  // to do `@activate(fsm_state.callback)`
  fsm_state.state = StateEnum.Callback;
}

// For `scatter`, transfering data is almost the same as `broadcast`:
// generally speaking, the installed-filter does most of the heavy lifting of
// distributing wavelets between the many PEs.
// However, because we cannot set up a RAMP -> RAMP route in addition to
// RAMP -> EAST, WEST, the root PE must also copy over its own chunk of the
// data to the `recv_buffer`
fn transfer_data_scatter() void {
  if (cur_network_cfg.root == pe_id) {
    // scatter has the same routing as broadcast, it does not have R --> R,
    // so the root does not send data to itself, we need another mov32 to
    // copy data from `send_buf` to `recv_buf`
    // WARNING: only single set of DSR is used, so we must perform non-async
    // task first

    // (1) copy data locally
    var dst = @set_dsd_length(mem, cur_network_cfg.count);
    dst = @set_dsd_base_addr(dst, fsm_state.recv_buf);

    var src = @set_dsd_length(mem, cur_network_cfg.count);
    src = @set_dsd_base_addr(src, fsm_state.send_buf);
    src = @increment_dsd_offset(src, @as(i16, pe_id * cur_network_cfg.count), u32);

    // Copy over the root's chunk of the data from `send_buf` to `recv_buf`
    @load_to_dsr(dest_dsr, dst); // dest DSR points to `recv_buf`
    @load_to_dsr(src1_dsr, src); // s1dsr points to `send_buf`
    @mov32(dest_dsr, src1_dsr);
    //@mov32(dst, src);

    // (2) broadcast data to other PEs
    fabout = @set_dsd_length(fabout, cur_network_cfg.count * NUM_PES);
    mem = @set_dsd_length(mem, cur_network_cfg.count * NUM_PES);
    mem = @set_dsd_base_addr(mem, fsm_state.send_buf);

    // NOTE: at the end of this data transfer, we activate ACTIVATE_FSM_TASK_ID
    mem_to_fabout(fabout, mem);

  } else {
    fabin = @set_dsd_length(fabin, cur_network_cfg.count);
    mem = @set_dsd_length(mem, cur_network_cfg.count);
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);

    // NOTE: at the end of this data transfer, we activate ACTIVATE_FSM_TASK_ID
    fabin_to_mem(mem, fabin);
  }

  // when we next run through `fsm()`, we'll be in the `Callback` state ready
  // to do `@activate(fsm_state.callback)`
  fsm_state.state = StateEnum.Callback;
}

// Transfer data in gather if we are the `root` PE
fn transfer_data_gather_root(root: u16, count: u16) void {
  // In `gather`, if we are the root, we must receive first from
  // NEG_DIR, then copy our own data over, then receive from POS_DIR
  if (fsm_state.counter == root) {

    // If our counter is at the `root`, this means that we should copy data
    // over from `send_buf` to `recv_buf` locally
    mem = @set_dsd_length(mem, count);
    const src = @set_dsd_base_addr(mem, fsm_state.send_buf);
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    mem = @increment_dsd_offset(mem, @as(i16, root * count), u32);

    @load_to_dsr(dest_dsr, mem);
    @load_to_dsr(src1_dsr, src);
    @mov32(dest_dsr, src1_dsr);
    //@mov32(mem, src);
    fsm_state.counter += 1;

    // If we are the last PE in the row or column, then there is no step
    // after this! No data to receive from POS_DIR, so, we move to the
    // `StateEnum.Callback` state.
    if (root == NUM_PES - 1) {
      fsm_state.state = StateEnum.Callback;
    }
    @activate(ACTIVATE_FSM_TASK_ID);

  } else if (fsm_state.counter == 0) {

    // If our `fsm_state.counter` is 0 and we are in this case
    // (instead of the `fsm_state.counter == root` case above), we know that
    // `root != 0`. We are now receiving data from NEG_DIR, but that data
    // is arriving in reverse order because this allows us to ingest all
    // data in a single mem1d_dsd operation.

    const neg_dir_size = count * root;

    fabin = @set_dsd_length(fabin, neg_dir_size);

    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    mem = @set_dsd_length(mem, neg_dir_size);
    mem = @increment_dsd_offset(mem, @as(i16, neg_dir_size) - 1, u32);

    // Because we are receiving data in reverse order, we create a fresh
    // dsd with stride negative 1.
    const rev = @set_dsd_stride(mem, -1);

    fabin_to_mem(rev, fabin);

    // Once we are done ingesting data from NEG_DIR, we move onto the `root`
    // state
    fsm_state.counter = root;

  } else {

    // Finally, we are ingesting data from POS_DIR, and we receive this data
    // in the correct order. This is a simple receive operation.
    @assert(fsm_state.counter == root + 1);

    const offset = (root + 1) * count;
    const pos_dir_size = (NUM_PES - root - 1) * count;

    fabin = @set_dsd_length(fabin, pos_dir_size);

    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    mem = @set_dsd_length(mem, pos_dir_size);
    mem = @increment_dsd_offset(mem, @as(i16, offset), u32);

    fabin_to_mem(mem, fabin);
    fsm_state.state = StateEnum.Callback;
  }
}

// We need to use functions like these instead of putting DSD ops directly into
// the code in order to trick the DSR allocator to reuse DSRs. All instances
// of this function are known not to run concurrently with itself, so this is
// safe.
// If we do not do this, the DSR allocator will fail.
fn fabin_to_mem(m: mem1d_dsd, f: fabin_dsd) void {
  @load_to_dsr(dest_dsr, m);
  @load_to_dsr(src1_dsr, f, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @mov32(dest_dsr, src1_dsr, .{.async=true} );
  //@mov32(m, f, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
}

// reduce_or's counterpart of fabin_to_mem -- @mov16 instead of @mov32.
// @mov32 moving a u16-element (mem16) DSD would move count16 32-bit words
// (i.e. 2x count16 16-bit elements' worth of bytes) instead of count16
// 16-bit elements -- confirmed as the actual bug behind reduce_or's fabric
// stall (P=2 "passed" only because the resulting over-read/over-write
// happened not to corrupt anything observable at that tiny scale; P=3
// exposed a genuine protocol-level hang).
fn fabin_to_mem16(m: mem1d_dsd, f: fabin_dsd) void {
  @load_to_dsr(dest_dsr, m);
  @load_to_dsr(src1_dsr, f, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @mov16(dest_dsr, src1_dsr, .{.async=true} );
}

// Same as `fabin_to_mem`
fn mem_to_fabout(f: fabout_dsd, m: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, f, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @load_to_dsr(src1_dsr, m);
  @mov32(dest_dsr, src1_dsr, .{.async=true} );
  //@mov32(f, m, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
}

// reduce_or's counterpart of mem_to_fabout -- @mov16, see fabin_to_mem16.
fn mem_to_fabout16(f: fabout_dsd, m: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, f, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @load_to_dsr(src1_dsr, m);
  @mov16(dest_dsr, src1_dsr, .{.async=true} );
}

// Same as `fabin_to_mem`
//fn fadds(dst: anytype, src0: anytype, src1: anytype) void {
//  @fadds(dst, src0, src1, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
//}

fn fadds_fabout_fabin_mem(dst: fabout_dsd, src0: fabin_dsd, src1: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, dst, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @load_to_dsr(src0_dsr, src0, .{ .async = true});
  @load_to_dsr(src1_dsr, src1);
  @fadds(dest_dsr, src0_dsr, src1_dsr, .{.async=true} );
  //@fadds(dst, src0, src1, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
}

// the microthread ID for the thread is determined in the following order:
// 1) destination (dst)
// 2) src0
// 3) src1

// The length of the vector instruction is then determined in the following order:
// 1) If src0 has a non-zero length, that length is used.
// 2) If src1 has a non-zero length, that length is used.
// 3) If dst has a non-zero length, that length is used

fn fadds_mem_fabin_mem(dst: mem1d_dsd, src0: fabin_dsd, src1: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, dst);
  @load_to_dsr(src0_dsr, src0, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @load_to_dsr(src1_dsr, src1);
  @fadds(dest_dsr, src0_dsr, src1_dsr, .{.async=true} );
  //@fadds(dst, src0, src1, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
}

// reduce_or's counterparts to fadds_fabout_fabin_mem/fadds_mem_fabin_mem --
// identical structure, @or16 instead of @fadds. Operands are u16-element
// DSDs (see transfer_data_reduce_or()), matching @or16's native width.
fn or16_fabout_fabin_mem(dst: fabout_dsd, src0: fabin_dsd, src1: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, dst, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @load_to_dsr(src0_dsr, src0, .{ .async = true});
  @load_to_dsr(src1_dsr, src1);
  @or16(dest_dsr, src0_dsr, src1_dsr, .{.async=true} );
}

fn or16_mem_fabin_mem(dst: mem1d_dsd, src0: fabin_dsd, src1: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, dst);
  @load_to_dsr(src0_dsr, src0, .{ .async = true, .activate = ACTIVATE_FSM_TASK_ID });
  @load_to_dsr(src1_dsr, src1);
  @or16(dest_dsr, src0_dsr, src1_dsr, .{.async=true} );
}

// Same as `fabin_to_mem`
fn mem_to_fabout_no_activate(f: fabout_dsd, m: mem1d_dsd) void {
  @load_to_dsr(dest_dsr, f, .{ .async = true });
  @load_to_dsr(src1_dsr, m);
  @mov32(dest_dsr, src1_dsr, .{.async=true} );
  //@mov32(f, m, .{ .async = true });
}

// Gather is a multi-phase FSM
fn transfer_data_gather() void {

  const root = cur_network_cfg.root;
  const count = cur_network_cfg.count;
  if (root == pe_id) {

    transfer_data_gather_root(root, count);

  } else if (fsm_state.counter == 0) {
    // We're a non-root node, responsible for sending our data towards the root
    // in the first pass through the FSM

    fabout_adv = @set_dsd_length(fabout_adv, count);
    mem = @set_dsd_length(mem, count);
    mem = @set_dsd_base_addr(mem, fsm_state.send_buf);

    var tmp = mem;
    // If our `pe_id` is less than `root`, then we must send data in reverse
    // to allow the root PE to receive it in a single `mem1d_dsd` operation.
    // To avoid breaking `mem` by setting a negative stride, we do these
    // operations with a temporary DSD `tmp`.
    if (pe_id < root) {
      tmp = @increment_dsd_offset(tmp, @as(i16, count) - 1, u32);
      tmp = @set_dsd_stride(tmp, - 1);
    }

    // If we are PE0 and the root is somewhere in the middle of our row or
    // column, after we are done sending our data, we are responsible for
    // sending the control wavelet that flips root's switch to allow it to
    // start receiving from POS_DIR
    const send_ctrl_wavelet = (pe_id == 0) and (root != NUM_PES - 1);
    if (!send_ctrl_wavelet) {
      // If we are not in that case, we are done and can move to the callback
      // state
      fsm_state.state = StateEnum.Callback;
    }
    mem_to_fabout(fabout_adv, tmp);

    fsm_state.counter += 1;
  } else {
    // We send a single control wavelet to flip root's switch, allowing it to
    // start receiving from POS_DIR
    @assert(pe_id == 0);
    @assert(root != NUM_PES - 1);

    ctrl_buf[0] = comptime ctrl.wavelet(.{ .cmd0 = .{ .no_ce = true, .type = ctrl.Cmd.Advance } });
    mem_to_fabout(ctrl_out, ctrl_mem);
    fsm_state.state = StateEnum.Callback;
  }
}

// Reduce is the only function in this library that involves both COLOR_0 and
// COLOR_1
fn transfer_data_reduce() void {

  const count = cur_network_cfg.count;
  const root = cur_network_cfg.root;

  reduce_pos_fabin = @set_dsd_length(reduce_pos_fabin, count);
  reduce_neg_fabin = @set_dsd_length(reduce_neg_fabin, count);

  reduce_pos_fabout = @set_dsd_length(reduce_pos_fabout, count);
  reduce_neg_fabout = @set_dsd_length(reduce_neg_fabout, count);

  mem = @set_dsd_length(mem, count);

  // If we are the root on the first pass through the FSM, we receive/aggregate
  // data from *other* PEs
  if (pe_id == root and fsm_state.counter == 0) {
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);

    switch (pe_id) {
      0 => {
        fabin_to_mem(mem, reduce_pos_fabin);
      },
      (NUM_PES - 1) => {
        fabin_to_mem(mem, reduce_neg_fabin);
      },
      else => {
        // WSE3 does not support 2 FABIN source operands.
        // Instead of "mem = reduce_pos_fabin + reduce_neg_fabin", we can do
        // "mem = reduce_pos_fabin"
        // "mem = reduce_neg_fabin + mem"
        fabin_to_mem(mem, reduce_pos_fabin);
      }
    }
    // We need another run through the FSM so that we can add in our own local
    // copy of the data
    fsm_state.counter += 1;
  } else if (pe_id == root and fsm_state.counter == 1) {
    // fsm_state.counter = 1
    // - pe_id = 0 or (NUM_PES - 1) skips this branch and execute next branch
    // - pe_id = [1, (NUM_PES - 1)) executes this branch
    // "mem = reduce_neg_fabin + mem"
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    switch (pe_id) {
      0 => {
        @activate(ACTIVATE_FSM_TASK_ID);
      },
      (NUM_PES - 1) => {
        @activate(ACTIVATE_FSM_TASK_ID);
      },
      else => {
        fadds_mem_fabin_mem(mem, reduce_neg_fabin, mem);
      }
    }
    fsm_state.counter += 1;
  } else if (pe_id == root) {
    // fsm_state.counter = 2
    // Add in our own local copy of the data
    mem = @set_dsd_length(mem, count);
    const src = @set_dsd_base_addr(mem, fsm_state.send_buf);
    const dst = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    // all operands are mem1d
    @load_to_dsr(dest_dsr, dst);
    @load_to_dsr(src0_dsr, dst);
    @load_to_dsr(src1_dsr, src);
    @fadds(dest_dsr, src0_dsr, src1_dsr);
    //@fadds(dst, dst, src);
    fsm_state.state = StateEnum.Callback;
    @activate(ACTIVATE_FSM_TASK_ID);

  } else {

    // If we are not the root, we simply need to figure out which DSDs to use,
    // then send/receive data through the appropriate ones
    mem = @set_dsd_base_addr(mem, fsm_state.send_buf);
    if (pe_id == 0) {
      mem_to_fabout(reduce_pos_fabout, mem);
    } else if (pe_id == NUM_PES - 1) {
      mem_to_fabout(reduce_neg_fabout, mem);
    } else if (pe_id < root) {
      fadds_fabout_fabin_mem(reduce_pos_fabout, reduce_neg_fabin, mem);
    } else {
      fadds_fabout_fabin_mem(reduce_neg_fabout, reduce_pos_fabin, mem);
    }
    fsm_state.state = StateEnum.Callback;
  }
}

// Bitwise-OR counterpart of transfer_data_reduce() -- same structure and
// branching (root/non-root, first-pass ingestion vs combine vs own-copy
// merge, extreme-PE-vs-middle-PE special cases), @or16 instead of @fadds.
// CSL has no @or32, only @or16 (16-bit elements) -- so every DSD driving an
// OR op here counts 16-bit halves (count16 = count*2), not the caller's
// u32-word count, and uses mem16 (u16-typed) instead of mem (u32-typed).
// The fabric-side reduce_pos/neg_fabin/fabout DSDs are queue-bound, not
// memory-address-typed, so they're reused completely unchanged from the
// reduce_fadds path, just re-lengthed to count16 instead of count -- no
// simd_mode packing needed (tried, reverted -- see fabin_to_mem16/
// mem_to_fabout16's own comment for the actual bug and fix, which was
// @mov32 vs @mov16 on the plain-move helpers, not fabric SIMD packing).
fn transfer_data_reduce_or() void {

  const count = cur_network_cfg.count;
  const count16 = count * 2;
  const root = cur_network_cfg.root;

  reduce_pos_fabin = @set_dsd_length(reduce_pos_fabin, count16);
  reduce_neg_fabin = @set_dsd_length(reduce_neg_fabin, count16);

  reduce_pos_fabout = @set_dsd_length(reduce_pos_fabout, count16);
  reduce_neg_fabout = @set_dsd_length(reduce_neg_fabout, count16);

  mem16 = @set_dsd_length(mem16, count16);

  // If we are the root on the first pass through the FSM, we receive/aggregate
  // data from *other* PEs
  if (pe_id == root and fsm_state.counter == 0) {
    mem16 = @set_dsd_base_addr(mem16, @ptrcast([*]u16, fsm_state.recv_buf));

    switch (pe_id) {
      0 => {
        fabin_to_mem16(mem16, reduce_pos_fabin);
      },
      (NUM_PES - 1) => {
        fabin_to_mem16(mem16, reduce_neg_fabin);
      },
      else => {
        // WSE3 does not support 2 FABIN source operands.
        // Instead of "mem16 = reduce_pos_fabin + reduce_neg_fabin", we can do
        // "mem16 = reduce_pos_fabin"
        // "mem16 = reduce_neg_fabin OR mem16"
        fabin_to_mem16(mem16, reduce_pos_fabin);
      }
    }
    // We need another run through the FSM so that we can add in our own local
    // copy of the data
    fsm_state.counter += 1;
  } else if (pe_id == root and fsm_state.counter == 1) {
    // fsm_state.counter = 1
    // - pe_id = 0 or (NUM_PES - 1) skips this branch and execute next branch
    // - pe_id = [1, (NUM_PES - 1)) executes this branch
    // "mem16 = reduce_neg_fabin OR mem16"
    mem16 = @set_dsd_base_addr(mem16, @ptrcast([*]u16, fsm_state.recv_buf));
    switch (pe_id) {
      0 => {
        @activate(ACTIVATE_FSM_TASK_ID);
      },
      (NUM_PES - 1) => {
        @activate(ACTIVATE_FSM_TASK_ID);
      },
      else => {
        or16_mem_fabin_mem(mem16, reduce_neg_fabin, mem16);
      }
    }
    fsm_state.counter += 1;
  } else if (pe_id == root) {
    // fsm_state.counter = 2
    // Add in our own local copy of the data
    mem16 = @set_dsd_length(mem16, count16);
    const src = @set_dsd_base_addr(mem16, @ptrcast([*]u16, fsm_state.send_buf));
    const dst = @set_dsd_base_addr(mem16, @ptrcast([*]u16, fsm_state.recv_buf));
    // all operands are mem1d
    @load_to_dsr(dest_dsr, dst);
    @load_to_dsr(src0_dsr, dst);
    @load_to_dsr(src1_dsr, src);
    @or16(dest_dsr, src0_dsr, src1_dsr);
    fsm_state.state = StateEnum.Callback;
    @activate(ACTIVATE_FSM_TASK_ID);

  } else {

    // If we are not the root, we simply need to figure out which DSDs to use,
    // then send/receive data through the appropriate ones
    mem16 = @set_dsd_base_addr(mem16, @ptrcast([*]u16, fsm_state.send_buf));
    if (pe_id == 0) {
      mem_to_fabout16(reduce_pos_fabout, mem16);
    } else if (pe_id == NUM_PES - 1) {
      mem_to_fabout16(reduce_neg_fabout, mem16);
    } else if (pe_id < root) {
      or16_fabout_fabin_mem(reduce_pos_fabout, reduce_neg_fabin, mem16);
    } else {
      or16_fabout_fabin_mem(reduce_neg_fabout, reduce_pos_fabin, mem16);
    }
    fsm_state.state = StateEnum.Callback;
  }
}

// Select-any counterpart of transfer_data_reduce()/transfer_data_reduce_or()
// -- same root/non-root, extreme-PE/middle-PE branching and alternating-
// color routing, but NO fused ALU combine exists for this op (see
// select_merge_u32's own comment), so every hop that would be one fused
// async instruction in reduce_fadds/reduce_or here becomes an explicit
// receive (plain @mov32, reusing the existing generic fabin_to_mem/
// mem_to_fabout helpers unchanged) followed by an ordinary synchronous
// select_merge_u32() compute pass, then a plain forward.
//
// Only 2 buffers (send_buf/recv_buf), not 3 -- see reduce_select_any's own
// comment for the in-place trick: a middle root merges its OWN value into
// recv_buf right after its first incoming side lands (moved earlier than
// you'd naively expect -- reduce_fadds/reduce_or do their "own copy" merge
// LAST, since their fused op lets them do it in one shot regardless of
// order). Doing it early means send_buf's value has already been consumed
// by the time the second side needs somewhere to land, so send_buf's own
// memory can BE that landing zone -- no separate scratch buffer needed.
// Same idea for non-root middle PEs: their own recv_buf is never read by
// anyone (only the root's matters to the caller), so it doubles as their
// landing zone too, merged with send_buf in place before forwarding.
fn transfer_data_reduce_select_any() void {

  const count = cur_network_cfg.count;
  const root = cur_network_cfg.root;
  const sentinel = cur_network_cfg.sentinel;

  reduce_pos_fabin = @set_dsd_length(reduce_pos_fabin, count);
  reduce_neg_fabin = @set_dsd_length(reduce_neg_fabin, count);
  reduce_pos_fabout = @set_dsd_length(reduce_pos_fabout, count);
  reduce_neg_fabout = @set_dsd_length(reduce_neg_fabout, count);
  mem = @set_dsd_length(mem, count);

  if (pe_id == root and fsm_state.counter == 0) {
    // Root, first pass: ingest one side raw into recv_buf (same "ingest
    // pos first" idiom reduce_fadds/reduce_or use, per
    // configure_reduce_network()'s own comment about WSE3 not supporting
    // 2 FABIN source operands).
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    switch (pe_id) {
      0 => {
        fabin_to_mem(mem, reduce_pos_fabin);
      },
      (NUM_PES - 1) => {
        fabin_to_mem(mem, reduce_neg_fabin);
      },
      else => {
        fabin_to_mem(mem, reduce_pos_fabin);
      }
    }
    fsm_state.counter += 1;

  } else if (pe_id == root and fsm_state.counter == 1) {
    // Root, second pass: merge OWN value into recv_buf NOW (not saved for
    // last) -- this consumes send_buf's value, freeing its memory to
    // reuse as the landing zone for a middle root's second side.
    select_merge_u32(fsm_state.recv_buf, fsm_state.recv_buf, fsm_state.send_buf, count, sentinel);
    switch (pe_id) {
      0 => {
        // Extreme root: no second side exists -- done.
        fsm_state.state = StateEnum.Callback;
        @activate(ACTIVATE_FSM_TASK_ID);
      },
      (NUM_PES - 1) => {
        fsm_state.state = StateEnum.Callback;
        @activate(ACTIVATE_FSM_TASK_ID);
      },
      else => {
        // Middle root: ingest side B directly into send_buf's now-free
        // memory (in place -- no dedicated scratch buffer).
        mem = @set_dsd_base_addr(mem, fsm_state.send_buf);
        fabin_to_mem(mem, reduce_neg_fabin);
        fsm_state.counter += 1;
      }
    }

  } else if (pe_id == root) {
    // Root, counter == 2 (middle root only): side B has landed in
    // send_buf's repurposed memory -- merge it into recv_buf and finish.
    select_merge_u32(fsm_state.recv_buf, fsm_state.send_buf, fsm_state.recv_buf, count, sentinel);
    fsm_state.state = StateEnum.Callback;
    @activate(ACTIVATE_FSM_TASK_ID);

  } else if (pe_id == 0) {
    // Extreme non-root: nothing arrives from "before" us -- just forward
    // our own copy toward root. send_buf untouched, no merge needed.
    mem = @set_dsd_base_addr(mem, fsm_state.send_buf);
    mem_to_fabout(reduce_pos_fabout, mem);
    fsm_state.state = StateEnum.Callback;

  } else if (pe_id == NUM_PES - 1) {
    mem = @set_dsd_base_addr(mem, fsm_state.send_buf);
    mem_to_fabout(reduce_neg_fabout, mem);
    fsm_state.state = StateEnum.Callback;

  } else if (fsm_state.counter == 0) {
    // Middle, non-root, first pass: ingest whatever's accumulated so far
    // directly into recv_buf -- otherwise-unused memory on this PE, since
    // only the root's recv_buf is ever read by the caller.
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    if (pe_id < root) {
      fabin_to_mem(mem, reduce_neg_fabin);
    } else {
      fabin_to_mem(mem, reduce_pos_fabin);
    }
    fsm_state.counter += 1;

  } else {
    // Middle, non-root, second pass: merge with our own copy IN PLACE in
    // recv_buf, forward the result toward root.
    select_merge_u32(fsm_state.recv_buf, fsm_state.recv_buf, fsm_state.send_buf, count, sentinel);
    mem = @set_dsd_base_addr(mem, fsm_state.recv_buf);
    if (pe_id < root) {
      mem_to_fabout(reduce_pos_fabout, mem);
    } else {
      mem_to_fabout(reduce_neg_fabout, mem);
    }
    fsm_state.state = StateEnum.Callback;
  }
}

// Function that dispatches appropriate type of data-transfer function depending
// on the type of collective communication primitive being used
fn transfer_data() void {
  switch (cur_network_cfg.type) {
    Ftype.broadcast => {
      transfer_data_broadcast();
    },
    Ftype.scatter => {
      transfer_data_scatter();
    },
    Ftype.gather => {
      transfer_data_gather();
    },
    Ftype.reduce_or => {
      // named explicitly rather than folded into the else below --
      // two reduce variants silently sharing one else branch is a footgun.
      transfer_data_reduce_or();
    },
    Ftype.reduce_select_any => {
      // named explicitly for the same reason reduce_or is -- three reduce
      // variants silently sharing one else branch would be an even bigger
      // footgun.
      transfer_data_reduce_select_any();
    },
    else => {
      transfer_data_reduce();
    }
  }
}


comptime {
  @comptime_assert(dim_params.ids.present);

  // Initialize input queues and associated with a color
  @initialize_queue(COLOR_0_IQ, .{ .color = DATA_COLOR_0 });
  @initialize_queue(COLOR_1_IQ, .{ .color = DATA_COLOR_1 });

  // Bind our relevant tasks
  @bind_local_task(fsm, ACTIVATE_FSM_TASK_ID);

  // We need to install a placeholder filter just to allow for filter reconfiguration
  // in `scatter`
  // This current filter is a no-op
  const filter = .{
    .count_data = true,
    .kind = .{ .counter = true },
    .init_counter = 0,
    .max_counter = 0,
    .limit1 = 0
  };

  // We use these two values instead of passing the actual pe_index to each
  // pe at compile-time and generating a lot of ELFs
  const pe_min = dim_params.pe_min;
  const pe_max = dim_params.pe_max;

  // C0 and C1 are in teardown mode
  // The initial configuration is a broadcast network rooted at 0.
  // This is an arbitrary choice.
  if (pe_min) {
    @set_local_color_config(DATA_COLOR_0, .{ .routes = .{ .rx = .{ RAMP }, .tx = .{ POS_DIR } }, .filter = filter, .teardown = true });
  } else if (pe_max) {
    @set_local_color_config(DATA_COLOR_0, .{ .routes = .{ .rx = .{ NEG_DIR }, .tx = .{ RAMP } }, .filter = filter, .teardown = true });
  } else {
    @set_local_color_config(DATA_COLOR_0, .{ .routes = .{ .rx = .{ NEG_DIR }, .tx = .{ RAMP, POS_DIR } }, .filter = filter, .teardown = true });
  }
  @set_local_color_config(DATA_COLOR_1, .{ .routes = .{ .rx = .{ RAMP }, .tx = .{ RAMP } }, .teardown = true });

}

comptime {
  // necessary, otherwise the data is not sent into the output queue
  if (@is_arch("wse3")){
    @initialize_queue(COLOR_0_OQ, .{.color = DATA_COLOR_0 });
    @initialize_queue(COLOR_1_OQ, .{.color = DATA_COLOR_1 });
  }
}

var num_tds: u16 = 0;

fn teardown_handler_0() void {
  if (cur_network_cfg.type == Ftype.reduce_fadds or cur_network_cfg.type == Ftype.reduce_or
      or cur_network_cfg.type == Ftype.reduce_select_any) {
    // all three reduce ops use C0 and C1 -- NOT exhaustiveness-checked
    // (plain booleans, unlike initiate_teardowns()'s switch), so a missed
    // case here is a SILENT C_LOCK-never-unblocks hang, not a compile
    // error. Must stay in sync with every Ftype.reduce_* addition by hand.
    num_tds += 1;
    if (num_tds == 2){ // receive TD from C0 and C1
       num_tds = 0; // reset num_tds
       // LOCK can be picked only when the operation finishes
       @activate(C_LOCK);
    }
  }else{
    // others {bcast, gather, scatter} only use C0
    // LOCK can be picked only when the operation finishes
    @activate(C_LOCK);
  }
}

fn teardown_handler_1() void {
  // only reduce ops use C0 and C1 -- see teardown_handler_0's comment on
  // why this must be kept in sync by hand with every Ftype.reduce_* addition.
  @assert(cur_network_cfg.type == Ftype.reduce_fadds or cur_network_cfg.type == Ftype.reduce_or
          or cur_network_cfg.type == Ftype.reduce_select_any);
  num_tds += 1;
  if (num_tds == 2){ // receive TD from C0 and C1
    num_tds = 0; // reset num_tds
    // LOCK can be picked only when the operation finishes
    @activate(C_LOCK);
  }
}


comptime{
  @set_teardown_handler(teardown_handler_0, DATA_COLOR_0);
  @set_teardown_handler(teardown_handler_1, DATA_COLOR_1);
}


// LOCK runs only if TD is received and the operation (*) finishes
//
// Here is the sequence
// - the operation blocks LOCK in the beginning
// - teardown handler T29 activates LOCK
// - the operation unblocks LOCK when it finishes
// - LOCK is picked by the HW scheduler to perform the state transition
//
// (*) operation is {broadcast, scatter, gather, reduce_add}
//
task f_lock() void {
  @activate(fsm_state.callback);
}

comptime {
  @bind_local_task(f_lock, C_LOCK);
}
